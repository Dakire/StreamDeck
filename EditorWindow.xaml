<ui:FluentWindow x:Class="TouchDeck.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:b="clr-namespace:TouchDeck.Behaviors"
        xmlns:vm="clr-namespace:TouchDeck.ViewModels"
        xmlns:controls="clr-namespace:TouchDeck.Controls"
        Title="TouchDeck — Éditeur" Width="1400" Height="880" MinWidth="1120" MinHeight="700"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        WindowStartupLocation="Manual" ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" PreviewKeyDown="OnPreviewKeyDown" PreviewDragOver="OnWindowPreviewDragOver">

  <ui:FluentWindow.Resources>
    <!-- ===== Cases de la grille ===== -->
    <Style x:Key="SlotItem" TargetType="ListBoxItem">
      <Setter Property="Width" Value="144"/>
      <Setter Property="Height" Value="144"/>
      <Setter Property="Margin" Value="6"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="AllowDrop" Value="True"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
      <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Slot_PreviewMouseLeftButtonDown"/>
      <EventSetter Event="PreviewMouseRightButtonDown" Handler="Slot_PreviewMouseRightButtonDown"/>
      <EventSetter Event="PreviewMouseMove" Handler="Slot_PreviewMouseMove"/>
      <EventSetter Event="MouseDoubleClick" Handler="Slot_MouseDoubleClick"/>
      <EventSetter Event="ContextMenuOpening" Handler="Slot_ContextMenuOpening"/>
      <EventSetter Event="DragOver" Handler="Slot_DragOver"/>
      <EventSetter Event="DragLeave" Handler="Slot_DragLeave"/>
      <EventSetter Event="Drop" Handler="Slot_Drop"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
              <!-- fond : couleur du bouton, ou cadre pointillé pour une case vide -->
              <Border x:Name="Card" CornerRadius="16" Background="{Binding Face.Background}" BorderBrush="{Binding Face.Border}" BorderThickness="1"/>
              <Rectangle x:Name="EmptyFrame" RadiusX="16" RadiusY="16" Margin="1" Stroke="{DynamicResource DeckPlaceholder}"
                         StrokeThickness="2" StrokeDashArray="4 4" Visibility="Collapsed"/>
              <ui:SymbolIcon x:Name="EmptyPlus" Symbol="Add24" FontSize="30" Foreground="{DynamicResource DeckPlaceholder}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              <controls:TileFace Face="{Binding Face}" CornerRadius="16"/>
              <Border x:Name="Hover" CornerRadius="16" Background="White" Opacity="0" IsHitTestVisible="False"/>
              <!-- état de sélection, de focus clavier et de dépôt : trois repères distincts, jamais la couleur seule -->
              <Border x:Name="FocusRing" CornerRadius="16" BorderThickness="2" Margin="-3" BorderBrush="{DynamicResource DeckFocus}"
                      Visibility="Collapsed" IsHitTestVisible="False"/>
              <Border x:Name="SelectRing" CornerRadius="16" BorderThickness="4" BorderBrush="{DynamicResource DeckAccentText}"
                      Visibility="Collapsed" IsHitTestVisible="False"/>
              <Border x:Name="DropRing" CornerRadius="16" BorderThickness="4" BorderBrush="{DynamicResource DeckSuccess}"
                      Background="{DynamicResource DeckDropFill}" Visibility="Collapsed" IsHitTestVisible="False"/>
              <!-- configuration incorrecte : icône + infobulle -->
              <Border x:Name="IssueBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" CornerRadius="12"
                      Background="{DynamicResource DeckWindow}" Padding="3">
                <ui:SymbolIcon Symbol="{Binding IssueSymbol}" FontSize="18" Foreground="{DynamicResource DeckText}"/>
              </Border>
              <Border x:Name="OverflowTag" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" CornerRadius="8"
                      Background="{DynamicResource DeckWindow}" Padding="6,2">
                <TextBlock Text="Sous-page" FontSize="11" Foreground="{DynamicResource DeckText}"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource DeckSurface}"/>
                <Setter TargetName="Card" Property="BorderBrush" Value="Transparent"/>
                <Setter TargetName="EmptyFrame" Property="Visibility" Value="Visible"/>
                <Setter TargetName="EmptyPlus" Property="Visibility" Value="Visible"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding HasIssue}" Value="True">
                <Setter TargetName="IssueBadge" Property="Visibility" Value="Visible"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsOverflow}" Value="True">
                <Setter TargetName="OverflowTag" Property="Visibility" Value="Visible"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                <Setter TargetName="DropRing" Property="Visibility" Value="Visible"/>
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="0.10"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
              </Trigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                  <Condition Binding="{Binding IsBack}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="SelectRing" Property="Visibility" Value="Visible"/>
              </MultiDataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Onglets de pages ===== -->
    <Style x:Key="PageTabItem" TargetType="ListBoxItem">
      <Setter Property="MinHeight" Value="48"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="AllowDrop" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource DeckFocusVisual}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
      <EventSetter Event="ContextMenuOpening" Handler="PageTab_ContextMenuOpening"/>
      <EventSetter Event="PreviewMouseRightButtonDown" Handler="PageTab_PreviewMouseRightButtonDown"/>
      <EventSetter Event="DragOver" Handler="PageTab_DragOver"/>
      <EventSetter Event="DragLeave" Handler="PageTab_DragLeave"/>
      <EventSetter Event="Drop" Handler="PageTab_Drop"/>
      <EventSetter Event="MouseDoubleClick" Handler="PageTab_MouseDoubleClick"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chip" CornerRadius="24" Padding="20,0" MinHeight="48" Background="{DynamicResource DeckSurface}"
                    BorderBrush="{DynamicResource DeckLine}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon x:Name="HiddenIcon" Symbol="EyeOff16" FontSize="14" Margin="0,0,6,0" Visibility="Collapsed"/>
                <TextBlock x:Name="Label" Text="{Binding Display}" VerticalAlignment="Center" FontSize="14"
                           Foreground="{DynamicResource DeckText}"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding Hidden}" Value="True">
                <Setter TargetName="HiddenIcon" Property="Visibility" Value="Visible"/>
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource DeckSurfaceHi}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource DeckAccent}"/>
                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource DeckAccent}"/>
                <Setter TargetName="Label" Property="Foreground" Value="White"/>
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="HiddenIcon" Property="Foreground" Value="White"/>
              </Trigger>
              <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource DeckSuccess}"/>
                <Setter TargetName="Chip" Property="BorderThickness" Value="3"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Catalogue ===== -->
    <DataTemplate DataType="{x:Type vm:CatalogItemViewModel}">
      <Border x:Name="Row" Focusable="True" MinHeight="56" CornerRadius="10" Padding="6,4" Margin="0,1" Background="Transparent"
              FocusVisualStyle="{StaticResource DeckFocusVisual}" ToolTip="{Binding Description}"
              AutomationProperties.Name="{Binding AutomationName}"
              PreviewMouseLeftButtonDown="CatalogRow_PreviewMouseLeftButtonDown" PreviewMouseMove="CatalogRow_PreviewMouseMove"
              MouseLeftButtonUp="CatalogRow_MouseLeftButtonUp" PreviewMouseRightButtonDown="CatalogRow_PreviewMouseRightButtonDown"
              ContextMenuOpening="CatalogRow_ContextMenuOpening" KeyDown="CatalogRow_KeyDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="40" Height="40" CornerRadius="10" Background="{Binding Color}" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource DeckText}"/>
            <TextBlock Text="{Binding Description}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource DeckDim}"/>
          </StackPanel>
          <ui:Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="0" Appearance="Transparent"
                     Command="{Binding ToggleFavoriteCommand}" AutomationProperties.Name="{Binding FavoriteName}"
                     ToolTip="{Binding FavoriteName}">
            <ui:SymbolIcon Symbol="{Binding FavoriteGlyph}" FontSize="20"/>
          </ui:Button>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource DeckSurfaceHi}"/>
        </Trigger>
        <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource DeckSurfaceHi}"/>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CatalogSectionViewModel}">
      <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{Binding AutomationName}" FocusVisualStyle="{StaticResource DeckFocusVisual}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" MinHeight="40">
            <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding CountText}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource DeckDim}"/>
          </StackPanel>
        </Expander.Header>
        <ItemsControl ItemsSource="{Binding Items}" Focusable="False"/>
      </Expander>
    </DataTemplate>

    <!-- ===== Propriétés : étape d'un bouton ===== -->
    <DataTemplate DataType="{x:Type vm:IssueViewModel}">
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="16" VerticalAlignment="Top" Margin="0,2,8,0" Foreground="{DynamicResource DeckText}"/>
        <TextBlock FontSize="12" TextWrapping="Wrap" MaxWidth="290" Foreground="{DynamicResource DeckText}">
          <Run Text="{Binding Prefix, Mode=OneWay}" FontWeight="Bold"/><Run Text="{Binding Message, Mode=OneWay}"/>
        </TextBlock>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ActionStepViewModel}">
      <Border Background="{DynamicResource DeckSurface}" BorderBrush="{DynamicResource DeckLine}" BorderThickness="1"
              CornerRadius="12" Padding="14,6,14,14" Margin="0,0,0,10">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowUp24}" Command="{Binding MoveUpCommand}"
                         AutomationProperties.Name="Monter l'étape" ToolTip="Monter l'étape"
                         Visibility="{Binding CanMoveUp, Converter={StaticResource BoolVis}}"/>
              <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowDown24}" Command="{Binding MoveDownCommand}"
                         AutomationProperties.Name="Descendre l'étape" ToolTip="Descendre l'étape"
                         Visibility="{Binding CanMoveDown, Converter={StaticResource BoolVis}}"/>
              <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveCommand}"
                         AutomationProperties.Name="Supprimer l'étape" ToolTip="Supprimer l'étape"
                         Visibility="{Binding CanRemove, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
          </Grid>

          <TextBlock Text="Type" Style="{StaticResource EditorCaption}" Margin="2,0,0,6"/>
          <ItemsControl ItemsSource="{Binding TypeChoices}" Style="{StaticResource ChipWrap}"/>

          <TextBlock Text="{Binding ValueCaption}" Style="{StaticResource EditorCaption}"
                     Visibility="{Binding ShowValue, Converter={StaticResource BoolVis}}"/>
          <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}"
                      AutomationProperties.Name="{Binding ValueCaption}" b:HotkeyCapture.Enabled="True"
                      Visibility="{Binding ShowValue, Converter={StaticResource BoolVis}}"/>
          <ui:Button Content="Parcourir…" Icon="{ui:SymbolIcon Folder24}" Command="{Binding BrowseValueCommand}"
                     Style="{StaticResource EditorChip}" Margin="0,8,0,0" HorizontalAlignment="Left"
                     Visibility="{Binding ShowBrowseValue, Converter={StaticResource BoolVis}}"/>
          <TextBlock Text="{Binding ValueHint}" Style="{StaticResource EditorHint}"
                     Visibility="{Binding ShowValueHint, Converter={StaticResource BoolVis}}"/>

          <StackPanel Visibility="{Binding ShowMedia, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Commande média" Style="{StaticResource EditorCaption}"/>
            <ItemsControl ItemsSource="{Binding MediaChoices}" Style="{StaticResource ChipWrap}"/>
          </StackPanel>

          <StackPanel Visibility="{Binding ShowAudio, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Commande audio" Style="{StaticResource EditorCaption}"/>
            <ItemsControl ItemsSource="{Binding AudioChoices}" Style="{StaticResource ChipWrap}"/>
          </StackPanel>

          <StackPanel Visibility="{Binding ShowCommand, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Commande" Style="{StaticResource EditorCaption}"/>
            <ItemsControl ItemsSource="{Binding CommandChoices}" Style="{StaticResource ChipWrap}"/>
          </StackPanel>

          <StackPanel Visibility="{Binding ShowPage, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Aller à la page" Style="{StaticResource EditorCaption}"/>
            <ItemsControl ItemsSource="{Binding PageChoices}" Style="{StaticResource ChipWrap}"/>
          </StackPanel>

          <StackPanel Visibility="{Binding ShowProfile, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Afficher le profil" Style="{StaticResource EditorCaption}"/>
            <ItemsControl ItemsSource="{Binding ProfileChoices}" Style="{StaticResource ChipWrap}"/>
          </StackPanel>

          <ItemsControl ItemsSource="{Binding ProcessChoices}" Style="{StaticResource ChipWrap}" Margin="0,6,0,0"
                        Visibility="{Binding ShowProcesses, Converter={StaticResource BoolVis}}"/>

          <StackPanel Visibility="{Binding ShowArgs, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding ArgsCaption}" Style="{StaticResource EditorCaption}"/>
            <ui:TextBox Text="{Binding Args, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}"
                        AutomationProperties.Name="{Binding ArgsCaption}"/>
            <ui:Button Content="Parcourir…" Icon="{ui:SymbolIcon Folder24}" Command="{Binding BrowseArgsCommand}"
                       Style="{StaticResource EditorChip}" Margin="0,8,0,0" HorizontalAlignment="Left"
                       Visibility="{Binding ShowBrowseArgs, Converter={StaticResource BoolVis}}"/>
            <TextBlock Text="{Binding ArgsHint}" Style="{StaticResource EditorHint}"
                       Visibility="{Binding ShowArgsHint, Converter={StaticResource BoolVis}}"/>
          </StackPanel>

          <!-- Validation en direct : message lisible, annoncé aux lecteurs d'écran -->
          <ItemsControl ItemsSource="{Binding Issues}" Focusable="False" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:IconPickViewModel}">
      <ui:Button Width="48" Height="48" Padding="0" Margin="0,0,6,6" CornerRadius="10" Command="{Binding Command}"
                 FocusVisualStyle="{StaticResource DeckFocusVisual}"
                 AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Name}"
                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
        <ui:Button.Style>
          <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Appearance" Value="Primary"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ui:Button.Style>
        <ui:Button.Content>
          <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="22"/>
        </ui:Button.Content>
      </ui:Button>
    </DataTemplate>

    <!-- Carte de section du panneau de propriétés -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource DeckPanel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DeckLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,4,16,16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="PanelTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource DeckText}"/>
    </Style>

    <!-- La barre d'outils : listes déroulantes à hauteur tactile -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="MinHeight" Value="48"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource DeckFocusVisual}"/>
    </Style>
  </ui:FluentWindow.Resources>

  <AdornerDecorator>
    <Grid x:Name="RootGrid" Background="{DynamicResource DeckWindow}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <ui:TitleBar Grid.Row="0" Title="TouchDeck — Éditeur" ShowMinimize="True" ShowMaximize="True">
        <ui:TitleBar.Icon><ui:ImageIcon Source="Assets/logo.png"/></ui:TitleBar.Icon>
      </ui:TitleBar>

      <!-- ===== Barre supérieure : périphérique, profil, format, historique ===== -->
      <Border Grid.Row="1" Background="{DynamicResource DeckPanel}" BorderBrush="{DynamicResource DeckLine}" BorderThickness="0,0,0,1" Padding="14,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Profil -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="Person24" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="ProfileCombo" MinWidth="250" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                      AutomationProperties.Name="Profil modifié" ToolTip="Profil modifié (clic droit pour les options)"
                      ContextMenuOpening="ProfileCombo_ContextMenuOpening">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ProfileItemViewModel}">
                  <StackPanel MinHeight="40" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                      <TextBlock Text="  ● actif sur le deck" FontSize="12" Foreground="{DynamicResource DeckAccentText}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource DeckDim}"/>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
              <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                  <EventSetter Event="ContextMenuOpening" Handler="ProfileItem_ContextMenuOpening"/>
                  <EventSetter Event="PreviewMouseRightButtonDown" Handler="ProfileItem_PreviewMouseRightButtonDown"/>
                </Style>
              </ComboBox.ItemContainerStyle>
            </ComboBox>
            <ui:Button x:Name="ProfileMenuButton" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon MoreHorizontal24}"
                       AutomationProperties.Name="Options du profil" ToolTip="Options du profil : renommer, dupliquer, exporter…"
                       Click="ProfileMenuButton_Click"/>
            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Add24}" Command="{Binding NewProfileCommand}"
                       AutomationProperties.Name="Nouveau profil" ToolTip="Nouveau profil"/>
            <ui:Button Content="Afficher sur le deck" Icon="{ui:SymbolIcon Play24}" Command="{Binding ActivateCurrentProfileCommand}"
                       MinHeight="48" Margin="10,0,0,0" Padding="14,0" FocusVisualStyle="{StaticResource DeckFocusVisual}"
                       ToolTip="Définit ce profil comme profil affiché sur le deck">
              <ui:Button.Style>
                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActiveProfile}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:Button.Style>
            </ui:Button>
          </StackPanel>

          <!-- Format de l'appareil -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
            <ui:SymbolIcon Symbol="Grid24" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <ComboBox MinWidth="220" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                      AutomationProperties.Name="Format de la grille" ToolTip="Nombre de colonnes et de lignes de ce profil"/>
          </StackPanel>

          <!-- Périphérique : écran du deck -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
            <ui:SymbolIcon Symbol="Desktop24" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <ComboBox MinWidth="250" ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen, Mode=TwoWay}"
                      AutomationProperties.Name="Écran du deck" ToolTip="Écran sur lequel le deck s'affiche"/>
          </StackPanel>

          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                       AutomationProperties.Name="Annuler" ToolTip="{Binding UndoTooltip}"/>
            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowRedo24}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"
                       AutomationProperties.Name="Rétablir" ToolTip="{Binding RedoTooltip}"/>
            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Settings24}" Command="{Binding OpenSettingsCommand}"
                       AutomationProperties.Name="Paramètres" ToolTip="Paramètres de TouchDeck" Margin="14,0,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== Corps : catalogue | grille | propriétés ===== -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="330" MinWidth="260"/>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="*" MinWidth="420"/>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="400" MinWidth="320"/>
        </Grid.ColumnDefinitions>

        <!-- Catalogue d'actions -->
        <Border Grid.Column="0" Background="{DynamicResource DeckPanel}" BorderBrush="{DynamicResource DeckLine}" BorderThickness="0,0,1,0">
          <Grid Margin="12,12,6,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Actions" Style="{StaticResource PanelTitle}" Margin="2,0,0,10"/>
            <ui:TextBox x:Name="CatalogSearch" Grid.Row="1" Style="{StaticResource EditorInput}" Margin="0,0,6,0"
                        PlaceholderText="Rechercher une action…" Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                        Text="{Binding Catalog.Search, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Rechercher une action" PreviewKeyDown="CatalogSearch_PreviewKeyDown"/>
            <TextBlock Grid.Row="2" Text="{Binding Catalog.ResultsText}" Style="{StaticResource EditorHint}" Margin="4,6,0,4"
                       AutomationProperties.LiveSetting="Polite"/>
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,6,12" PanningMode="VerticalOnly"
                          KeyboardNavigation.DirectionalNavigation="Contained">
              <StackPanel>
                <ItemsControl ItemsSource="{Binding Catalog.Sections}" Focusable="False"/>
                <!-- État vide : aucun résultat -->
                <StackPanel HorizontalAlignment="Center" Margin="0,40,0,0">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Catalog.HasResults}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <ui:SymbolIcon Symbol="SearchInfo24" FontSize="40" Foreground="{DynamicResource DeckDim}" HorizontalAlignment="Center"/>
                  <TextBlock Text="Aucune action trouvée" Margin="0,10,0,4" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                  <TextBlock Text="Essaie un autre mot : « chrome », « volume », « script »…" Style="{StaticResource EditorHint}" TextAlignment="Center"/>
                  <ui:Button Content="Effacer la recherche" Command="{Binding Catalog.ClearSearchCommand}" Style="{StaticResource EditorChip}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"
                      AutomationProperties.Name="Redimensionner le catalogue" ToolTip="Glisser ou utiliser les flèches pour redimensionner"/>

        <!-- Centre : pages, fil d'Ariane, grille -->
        <Grid Grid.Column="2" Margin="18,14,18,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" LastChildFill="True">
            <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddPageCommand}"
                       AutomationProperties.Name="Nouvelle page" ToolTip="Nouvelle page"/>
            <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}" ItemContainerStyle="{StaticResource PageTabItem}"
                     BorderThickness="0" Background="Transparent" AutomationProperties.Name="Pages du profil"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>
          </DockPanel>

          <!-- Fil d'Ariane des dossiers -->
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Crumbs}" Margin="0,8,0,0" Focusable="False">
            <ItemsControl.Style>
              <Style TargetType="ItemsControl">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding InFolder}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:CrumbViewModel}">
                <StackPanel Orientation="Horizontal">
                  <ui:Button Command="{Binding Command}" Appearance="Transparent" MinHeight="48" Padding="12,0"
                             FocusVisualStyle="{StaticResource DeckFocusVisual}" AutomationProperties.Name="{Binding Text}">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="{Binding Symbol}" Margin="0,0,6,0" Visibility="{Binding HasSymbol, Converter={StaticResource BoolVis}}"/>
                      <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </ui:Button>
                  <ui:SymbolIcon Symbol="ChevronRight24" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource DeckDim}">
                    <ui:SymbolIcon.Style>
                      <Style TargetType="ui:SymbolIcon">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsLast}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ui:SymbolIcon.Style>
                  </ui:SymbolIcon>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Grille du deck, mise à l'échelle pour tenir dans la zone -->
          <Viewbox Grid.Row="2" Stretch="Uniform" StretchDirection="Both" Margin="0,18,0,10"
                   MaxWidth="{Binding GridMaxWidth}" MaxHeight="{Binding GridMaxHeight}" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Border Background="{DynamicResource DeckPanel}" BorderBrush="{DynamicResource DeckLine}" BorderThickness="1" CornerRadius="22" Padding="10">
              <ListBox x:Name="SlotList" ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot, Mode=TwoWay}"
                       ItemContainerStyle="{StaticResource SlotItem}" SelectionMode="Single" Background="Transparent" BorderThickness="0"
                       AutomationProperties.Name="Grille de boutons du deck"
                       KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Once"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       Padding="0" Focusable="False">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
            </Border>
          </Viewbox>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Center"
                      AutomationProperties.LiveSetting="Polite">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasOverflow}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <ui:SymbolIcon Symbol="Info16" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding OverflowText}" Style="{StaticResource EditorHint}" Margin="0"/>
          </StackPanel>
        </Grid>

        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"
                      AutomationProperties.Name="Redimensionner les propriétés" ToolTip="Glisser ou utiliser les flèches pour redimensionner"/>

        <!-- Propriétés -->
        <Border Grid.Column="4" Background="{DynamicResource DeckPanel}" BorderBrush="{DynamicResource DeckLine}" BorderThickness="1,0,0,0">
          <ScrollViewer x:Name="PropertiesScroll" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Padding="0,0,6,0">
            <StackPanel Margin="16,12,10,24" DataContext="{Binding Properties}">
              <TextBlock Text="Propriétés" Style="{StaticResource PanelTitle}" Margin="2,0,0,12"/>

              <!-- Rien de sélectionné -->
              <StackPanel Margin="0,40,0,0" HorizontalAlignment="Center" Visibility="{Binding IsNone, Converter={StaticResource BoolVis}}">
                <ui:SymbolIcon Symbol="CursorClick24" FontSize="44" Foreground="{DynamicResource DeckDim}" HorizontalAlignment="Center"/>
                <TextBlock Text="Aucune case sélectionnée" FontWeight="SemiBold" Margin="0,12,0,4" HorizontalAlignment="Center"/>
                <TextBlock Text="Clique sur une case de la grille pour régler son action, son titre et son icône." Style="{StaticResource EditorHint}"
                           TextAlignment="Center" MaxWidth="280"/>
              </StackPanel>

              <!-- Case vide -->
              <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                <Border Style="{StaticResource Card}" Padding="16,16">
                  <StackPanel>
                    <TextBlock Text="Case vide" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Text="Glisse une action du catalogue sur cette case, ou choisis une option ci-dessous." Style="{StaticResource EditorHint}"/>
                    <ui:Button Content="Parcourir les actions" Icon="{ui:SymbolIcon Search24}" Command="{Binding BrowseCatalogCommand}" Appearance="Primary"
                               Style="{StaticResource EditorChip}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                    <ui:Button Content="Créer un dossier" Icon="{ui:SymbolIcon FolderAdd24}" Command="{Binding CreateFolderCommand}"
                               Style="{StaticResource EditorChip}" Margin="0,0,0,0" HorizontalAlignment="Left"/>
                    <ui:Button Content="Coller" Icon="{ui:SymbolIcon ClipboardPaste24}" Command="{Binding PasteCommand}" IsEnabled="{Binding CanPaste}"
                               Style="{StaticResource EditorChip}" HorizontalAlignment="Left"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Bouton ou dossier -->
              <StackPanel Visibility="{Binding IsEditable, Converter={StaticResource BoolVis}}">

                <!-- Aperçu en direct -->
                <Border Style="{StaticResource Card}" Padding="16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="132" Height="132" CornerRadius="16" Background="{Binding Preview.Background}" BorderBrush="{Binding Preview.Border}" BorderThickness="1"
                            AutomationProperties.Name="Aperçu du bouton" AutomationProperties.HelpText="Rendu fidèle du bouton sur le deck">
                      <controls:TileFace Face="{Binding Preview}" CornerRadius="16"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource EditorHint}"/>
                      <TextBlock Text="{Binding FolderInfo}" Style="{StaticResource EditorHint}"/>
                      <ItemsControl ItemsSource="{Binding ButtonIssues}" Focusable="False" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Apparence -->
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Titre" Style="{StaticResource EditorCaption}"/>
                    <ui:TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}"
                                PlaceholderText="Titre affiché sur le bouton" AutomationProperties.Name="Titre du bouton"/>
                    <ui:ToggleSwitch Content="Afficher le titre sur le bouton" IsChecked="{Binding ShowTitle, Mode=TwoWay}" Margin="2,10,0,0" MinHeight="48"
                                     AutomationProperties.Name="Afficher le titre"/>
                    <TextBlock Text="Position du titre" Style="{StaticResource EditorCaption}"/>
                    <ItemsControl ItemsSource="{Binding PositionChoices}" Style="{StaticResource ChipWrap}"/>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Icône" Style="{StaticResource EditorCaption}"/>
                    <ui:TextBox x:Name="IconBox" Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}"
                                PlaceholderText="Nom Fluent (Play24), emoji ou texte court" AutomationProperties.Name="Icône du bouton"/>
                    <ui:TextBox Text="{Binding IconSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}" Margin="0,10,0,0"
                                PlaceholderText="Chercher une icône (en anglais : speaker, mail…)" Icon="{ui:SymbolIcon Search24}"
                                AutomationProperties.Name="Chercher une icône"/>
                    <ItemsControl ItemsSource="{Binding IconChoices}" Style="{StaticResource ChipWrap}" Margin="0,10,0,0"/>

                    <TextBlock Text="Image personnalisée" Style="{StaticResource EditorCaption}"/>
                    <StackPanel Orientation="Horizontal">
                      <ui:Button Content="Importer une image…" Icon="{ui:SymbolIcon ImageAdd24}" Command="{Binding ImportImageCommand}" Style="{StaticResource EditorChip}"/>
                      <ui:Button Content="Retirer" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveImageCommand}" Style="{StaticResource EditorChip}"
                                 Visibility="{Binding HasImage, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding FitChoices}" Style="{StaticResource ChipWrap}"
                                  Visibility="{Binding HasImage, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="PNG, JPEG, BMP, GIF, ICO, TIFF ou WebP, 15 Mo maximum. L'image est réduite à 512 px et copiée dans la configuration."
                               Style="{StaticResource EditorHint}"/>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Couleur du bouton" Style="{StaticResource EditorCaption}"/>
                    <ItemsControl ItemsSource="{Binding Swatches}" Style="{StaticResource ChipWrap}"/>
                    <ui:TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}"
                                PlaceholderText="#RRGGBB" AutomationProperties.Name="Couleur du bouton en hexadécimal"/>
                    <TextBlock Text="{Binding ColorError}" Foreground="{DynamicResource DeckDanger}" FontSize="12" TextWrapping="Wrap" Margin="2,6,0,0"
                               AutomationProperties.LiveSetting="Assertive"/>

                    <TextBlock Text="Couleur du texte et de l'icône" Style="{StaticResource EditorCaption}"/>
                    <ItemsControl ItemsSource="{Binding TextSwatches}" Style="{StaticResource ChipWrap}"/>
                    <ui:TextBox Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}"
                                PlaceholderText="Blanc par défaut" AutomationProperties.Name="Couleur du texte en hexadécimal"/>
                    <TextBlock Text="{Binding TextColorError}" Foreground="{DynamicResource DeckDanger}" FontSize="12" TextWrapping="Wrap" Margin="2,6,0,0"
                               AutomationProperties.LiveSetting="Assertive"/>

                    <ui:Button Content="Réinitialiser l'apparence" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetAppearanceCommand}"
                               Style="{StaticResource EditorChip}" Margin="0,14,0,0"/>
                  </StackPanel>
                </Border>

                <!-- Actions -->
                <Border Style="{StaticResource Card}" Visibility="{Binding IsButton, Converter={StaticResource BoolVis}}">
                  <StackPanel>
                    <TextBlock Text="{Binding StepsCaption}" Style="{StaticResource EditorCaption}" Margin="2,14,0,10"/>
                    <ItemsControl ItemsSource="{Binding Steps}" Focusable="False"/>
                    <TextBlock Text="Ce bouton n'a encore aucune action." Margin="2,0,0,8">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EditorHint}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSteps}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <ui:Button Content="Ajouter une étape" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddStepCommand}" Style="{StaticResource EditorChip}"/>
                    <TextBlock Text="Plusieurs étapes s'exécutent l'une après l'autre : programme, pause, raccourci, lien…" Style="{StaticResource EditorHint}"/>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Visibility="{Binding IsFolder, Converter={StaticResource BoolVis}}">
                  <StackPanel>
                    <TextBlock Text="Contenu du dossier" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding FolderInfo}" Style="{StaticResource EditorHint}"/>
                    <ui:Button Content="Ouvrir le dossier" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenFolderCommand}" Appearance="Primary"
                               Style="{StaticResource EditorChip}" Margin="0,12,0,0"/>
                  </StackPanel>
                </Border>

                <ui:Button Content="Supprimer ce bouton" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteCommand}" Appearance="Danger"
                           Style="{StaticResource EditorChip}" HorizontalAlignment="Left"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- ===== Barre d'état : périphérique, aide ===== -->
      <Border Grid.Row="3" Background="{DynamicResource DeckPanel}" BorderBrush="{DynamicResource DeckLine}" BorderThickness="0,1,0,0" Padding="16,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" MinHeight="32" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
            <ui:SymbolIcon FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center">
              <ui:SymbolIcon.Style>
                <Style TargetType="ui:SymbolIcon">
                  <Setter Property="Symbol" Value="PlugDisconnected24"/>
                  <Setter Property="Foreground" Value="{DynamicResource DeckDanger}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding DeviceConnected}" Value="True">
                      <Setter Property="Symbol" Value="PlugConnected24"/>
                      <Setter Property="Foreground" Value="{DynamicResource DeckSuccess}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
            <TextBlock Text="{Binding DeviceText}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource DeckTextSoft}"/>
            <TextBlock Text="{Binding AppMatchText}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource DeckDim}" Margin="16,0,0,0"/>
          </StackPanel>
          <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource DeckDim}"
                     Text="Ctrl+Z annuler  ·  Ctrl+C / X / V copier, couper, coller  ·  Suppr supprimer  ·  F2 titre  ·  Alt+flèches déplacer  ·  clic droit : menu"/>
        </Grid>
      </Border>

      <!-- ===== Notification discrète ===== -->
      <Border Grid.Row="2" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,52" MaxWidth="760"
              Background="{DynamicResource DeckSurfaceHi}" BorderBrush="{DynamicResource DeckLine}" BorderThickness="1" CornerRadius="12" Padding="16,4,6,4"
              Visibility="{Binding ToastVisible, Converter={StaticResource BoolVis}}" AutomationProperties.LiveSetting="Polite">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45"/></Border.Effect>
        <StackPanel Orientation="Horizontal" MinHeight="48">
          <ui:SymbolIcon FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0">
            <ui:SymbolIcon.Style>
              <Style TargetType="ui:SymbolIcon">
                <Setter Property="Symbol" Value="Info24"/>
                <Setter Property="Foreground" Value="{DynamicResource DeckAccentText}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ToastKind}" Value="Success">
                    <Setter Property="Symbol" Value="CheckmarkCircle24"/><Setter Property="Foreground" Value="{DynamicResource DeckSuccess}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ToastKind}" Value="Warning">
                    <Setter Property="Symbol" Value="Warning24"/><Setter Property="Foreground" Value="{DynamicResource DeckDanger}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ToastKind}" Value="Error">
                    <Setter Property="Symbol" Value="ErrorCircle24"/><Setter Property="Foreground" Value="{DynamicResource DeckDanger}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ui:SymbolIcon.Style>
          </ui:SymbolIcon>
          <TextBlock Text="{Binding ToastText}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" Foreground="{DynamicResource DeckText}"/>
          <ui:Button Content="{Binding ToastActionText}" Command="{Binding ToastActionCommand}" Appearance="Transparent" MinHeight="48" Margin="12,0,0,0"
                     Padding="14,0" FontWeight="SemiBold" Foreground="{DynamicResource DeckAccentText}" FocusVisualStyle="{StaticResource DeckFocusVisual}">
            <ui:Button.Style>
              <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ToastActionText}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </ui:Button.Style>
          </ui:Button>
          <ui:Button Style="{StaticResource IconButton}" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss16}" Command="{Binding DismissToastCommand}"
                     AutomationProperties.Name="Fermer la notification" ToolTip="Fermer"/>
        </StackPanel>
      </Border>
    </Grid>
  </AdornerDecorator>
</ui:FluentWindow>
