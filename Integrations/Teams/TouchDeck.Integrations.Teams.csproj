<Project Sdk="Microsoft.NET.Sdk">
  <!-- Microsoft Teams par son API locale « application tierce » (WebSocket sur le port 8124). Sans dépendance externe. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TouchDeck.Integrations.Teams</AssemblyName>
    <RootNamespace>TouchDeck.Integrations.Teams</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\TouchDeck.Core.csproj" />
  </ItemGroup>
</Project>