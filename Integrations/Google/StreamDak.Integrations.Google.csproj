<Project Sdk="Microsoft.NET.Sdk">
  <!-- Google Workspace (Sheets, Docs, Agenda) par OAuth 2.0 de bureau, avec le projet Google Cloud de l'utilisateur. Sans dépendance externe. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>StreamDak.Integrations.Google</AssemblyName>
    <RootNamespace>StreamDak.Integrations.Google</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\StreamDak.Core.csproj" />
  </ItemGroup>
</Project>