<Project Sdk="Microsoft.NET.Sdk">
  <!-- Badges de notifications (Gmail, Google Chat, Discord, Teams, Slack, services configurables) : le suivi des pages est fourni par l'application (INotificationWatcher). Sans dépendance externe. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>StreamDak.Integrations.Notifications</AssemblyName>
    <RootNamespace>StreamDak.Integrations.Notifications</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\StreamDak.Core.csproj" />
  </ItemGroup>
</Project>
