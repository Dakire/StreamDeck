<Project Sdk="Microsoft.NET.Sdk">
  <!-- Système Windows : charge processeur et mémoire, média en cours (SMTC). Cible Windows 10 2004 minimum pour l'API WinRT du média. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>StreamDak.Integrations.WindowsSystem</AssemblyName>
    <RootNamespace>StreamDak.Integrations.WindowsSystem</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\StreamDak.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.0" />
  </ItemGroup>
</Project>
