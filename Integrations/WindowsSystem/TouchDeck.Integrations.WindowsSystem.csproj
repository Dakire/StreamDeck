<Project Sdk="Microsoft.NET.Sdk">
  <!-- Système Windows : charge processeur et mémoire, média en cours (SMTC). Cible Windows 10 2004 minimum pour l'API WinRT du média. -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TouchDeck.Integrations.WindowsSystem</AssemblyName>
    <RootNamespace>TouchDeck.Integrations.WindowsSystem</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\TouchDeck.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.10" />
  </ItemGroup>
</Project>
