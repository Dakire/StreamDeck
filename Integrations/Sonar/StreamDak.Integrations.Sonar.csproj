<Project Sdk="Microsoft.NET.Sdk">
  <!-- SteelSeries Sonar (mélangeur de GG) : volumes et coupure des canaux par l'API HTTP locale de GG. API NON VÉRIFIÉE (voir docs/integrations/sonar.md). Sans dépendance externe. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>StreamDak.Integrations.Sonar</AssemblyName>
    <RootNamespace>StreamDak.Integrations.Sonar</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\StreamDak.Core.csproj" />
  </ItemGroup>
</Project>
