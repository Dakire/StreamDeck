<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TouchDeck</AssemblyName>
    <RootNamespace>TouchDeck</RootNamespace>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Compile Remove="Core\**" />
    <Compile Remove="Platform\Windows\**" />
    <Compile Remove="Integrations\**" />
    <EmbeddedResource Remove="tests\**" />
    <EmbeddedResource Remove="Core\**" />
    <EmbeddedResource Remove="Platform\Windows\**" />
    <EmbeddedResource Remove="Integrations\**" />
    <None Remove="tests\**" />
    <None Remove="Core\**" />
    <None Remove="Platform\Windows\**" />
    <None Remove="Integrations\**" />
    <Page Remove="tests\**" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Core\TouchDeck.Core.csproj" />
    <ProjectReference Include="Platform\Windows\TouchDeck.Platform.Windows.csproj" />
    <ProjectReference Include="Integrations\Obs\TouchDeck.Integrations.Obs.csproj" />
    <ProjectReference Include="Integrations\Vmix\TouchDeck.Integrations.Vmix.csproj" />
    <ProjectReference Include="Integrations\ElgatoLight\TouchDeck.Integrations.ElgatoLight.csproj" />
    <ProjectReference Include="Integrations\Hue\TouchDeck.Integrations.Hue.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.10" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
</Project>
