<Window x:Class="TouchDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TouchDeck" Width="1100" Height="650" Icon="Assets/icon.ico"
        WindowStyle="None" ResizeMode="NoResize" Topmost="False" ShowInTaskbar="True"
        ShowActivated="False" WindowStartupLocation="CenterScreen"
        Background="#0E1015"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        Stylus.IsPressAndHoldEnabled="False" Stylus.IsFlicksEnabled="False"
        Stylus.IsTapFeedbackEnabled="False" Stylus.IsTouchFeedbackEnabled="False">
  <Grid x:Name="Root"/>
</Window>
