<ui:FluentWindow x:Class="TouchDeck.PageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Modifier la page" Width="640" Height="460"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="Modifier la page" ShowMinimize="False" ShowMaximize="False"/>

    <StackPanel Grid.Row="1" Margin="24,12,24,18">
      <TextBlock Text="NOM DE LA PAGE" Style="{StaticResource EditorCaption}"/>
      <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}"/>

      <TextBlock Text="AFFICHAGE" Style="{StaticResource EditorCaption}"/>
      <WrapPanel>
        <ContentControl Content="{Binding VisibleChoice}"/>
        <ContentControl Content="{Binding HiddenChoice}"/>
      </WrapPanel>

      <TextBlock Text="ORDRE DES ONGLETS" Style="{StaticResource EditorCaption}"/>
      <WrapPanel>
        <ui:Button Content="Avant" Icon="{ui:SymbolIcon ChevronLeft24}" Command="{Binding MoveBeforeCommand}"
                   Style="{StaticResource EditorChip}"/>
        <ui:Button Content="Après" Icon="{ui:SymbolIcon ChevronRight24}"
                   Command="{Binding MoveAfterCommand}" Style="{StaticResource EditorChip}"/>
      </WrapPanel>

      <Grid Margin="0,22,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ui:Button Content="{Binding DeleteText}" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger"
                   Command="{Binding DeleteCommand}" Height="48" Padding="16,0"
                   Visibility="{Binding CanDelete, Converter={StaticResource BoolVis}}"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <ui:Button Content="Annuler" Command="{Binding CancelCommand}" Height="48" Margin="8,0,0,0" Padding="20,0"/>
          <ui:Button Content="Enregistrer" Appearance="Primary" Command="{Binding SaveCommand}"
                     Height="48" Margin="8,0,0,0" Padding="20,0"/>
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
