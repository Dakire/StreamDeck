<UserControl x:Class="StreamDak.Controls.WebWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:StreamDak.ViewModels">
  <!--
    Widget page web : une bande de commandes (48 px, tactile) et la page dans un cadre WebView2 isolé. Le cadre est une fenêtre Win32 enfant :
    rien de WPF ne peut le recouvrir, donc MainViewModel le masque quand un menu ou une boîte de dialogue est ouvert (Suspended).
    Hors interaction (modes passif et tactile), le cadre est désactivé : la souris et le doigt arrivent aux éléments WPF posés au-dessus (invisibles, car le
    cadre est dessiné par-dessus), le bouton transparent du mode tactile ou la surface inerte du mode passif.
  -->
  <Border Background="{Binding Face.Background}" BorderBrush="{Binding Face.Border}" BorderThickness="1" AutomationProperties.Name="{Binding AccessibleName}"
          Margin="{Binding DataContext.L.TilePad, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
          CornerRadius="{Binding DataContext.L.TileRadius, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Margin="14,4,6,4" Height="48">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button Command="{Binding GoBackCommand}" Width="48" Height="48" Padding="0" Margin="-10,0,4,0" Background="Transparent" BorderThickness="0"
                AutomationProperties.Name="Retour" ToolTip="Retour : page précédente, ou page de départ du cadre">
          <ui:SymbolIcon Symbol="ArrowLeft24" Foreground="{DynamicResource DeckAccentText}"/>
        </Button>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
          <ToggleButton IsChecked="{Binding IsInteracting, Mode=OneWay}" Command="{Binding ToggleInteractionCommand}" Width="48" Height="48" Padding="0" Margin="0,0,6,0"
                        Background="Transparent" BorderThickness="0" Visibility="{Binding CanToggleInteraction, Converter={StaticResource BoolVis}}"
                        AutomationProperties.Name="Interagir avec la page, ou terminer"
                        ToolTip="Interagir avec la page (liens, défilement) ; toucher de nouveau pour revenir à l'affichage seul">
            <ui:SymbolIcon Symbol="CursorClick24"/>
          </ToggleButton>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="{Binding Face.LabelBrush}"/>
            <TextBlock Text="{Binding InteractHint}" FontSize="11" Foreground="{DynamicResource DeckTextSoft}" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasInteractHint, Converter={StaticResource BoolVis}}" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="2" Command="{Binding ZoomOutCommand}" Width="48" Height="48" Padding="0" Background="Transparent" BorderThickness="0"
                AutomationProperties.Name="Dézoomer" ToolTip="Dézoomer">
          <ui:SymbolIcon Symbol="ZoomOut24"/>
        </Button>
        <Button Grid.Column="3" Command="{Binding ZoomResetCommand}" MinWidth="56" Height="48" Padding="6,0" Background="Transparent" BorderThickness="0"
                AutomationProperties.Name="Zoom, revenir à 100 %" ToolTip="Zoom : toucher pour revenir à 100 %">
          <TextBlock Text="{Binding ZoomText}" FontSize="13"/>
        </Button>
        <Button Grid.Column="4" Command="{Binding ZoomInCommand}" Width="48" Height="48" Padding="0" Background="Transparent" BorderThickness="0"
                AutomationProperties.Name="Zoomer" ToolTip="Zoomer">
          <ui:SymbolIcon Symbol="ZoomIn24"/>
        </Button>
        <Button Grid.Column="5" Command="{Binding ReloadCommand}" Width="48" Height="48" Padding="0" Background="Transparent" BorderThickness="0"
                AutomationProperties.Name="Recharger la page" ToolTip="Recharger la page">
          <ui:SymbolIcon Symbol="ArrowClockwise24"/>
        </Button>
        <Button Grid.Column="6" Command="{Binding OpenInBrowserCommand}" Width="48" Height="48" Padding="0" Background="Transparent" BorderThickness="0"
                AutomationProperties.Name="Ouvrir dans le navigateur" ToolTip="Ouvrir dans le navigateur (utile si le site refuse de s'afficher ici)">
          <ui:SymbolIcon Symbol="Open24"/>
        </Button>
        <ToggleButton Grid.Column="7" IsChecked="{Binding IsTyping, Mode=OneWay}" Command="{Binding ToggleTypingCommand}" Width="48" Height="48" Padding="0"
                      Background="Transparent" BorderThickness="0" AutomationProperties.Name="Saisie au clavier"
                      ToolTip="Saisie au clavier : la fenêtre prend le focus pour taper dans la page (touche à nouveau pour le rendre)">
          <ui:SymbolIcon Symbol="Keyboard24"/>
        </ToggleButton>
      </Grid>

      <Grid Grid.Row="1" Margin="2,0,2,2">
        <Grid x:Name="WebHost"/>   <!-- le WebView2 y est posé par la vue (WebFramePool : il passe d'une vue à l'autre sans recharger) -->
        <!-- Mode tactile au repos : un toucher ou un clic sur la page l'ouvre à l'interaction (l'appui long et le clic droit restent ceux de la case) -->
        <Button Command="{Binding InteractCommand}" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Visibility="{Binding ShowTouchShield, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Toucher pour interagir avec la page">
          <Button.Template>
            <ControlTemplate TargetType="Button"><Border Background="Transparent"/></ControlTemplate>
          </Button.Template>
        </Button>
        <!-- Mode passif au repos : surface inerte, la page ne réagit à rien -->
        <Border Background="Transparent" Visibility="{Binding ShowPassiveShield, Converter={StaticResource BoolVis}}"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}">
          <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource DeckDim}" HorizontalAlignment="Center" FontSize="32"/>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource DeckDim}" Margin="0,8,0,0"
                     AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
