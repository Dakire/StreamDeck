<ui:FluentWindow x:Class="StreamDak.Controls.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Saisie" Width="520" SizeToContent="Height" MinHeight="220"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <!-- Petite fenêtre de saisie d'un nom : Entrée valide, Échap annule, le champ est sélectionné à l'ouverture -->
  <Grid Background="{DynamicResource DeckWindow}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ui:TitleBar x:Name="Bar" Grid.Row="0" ShowMinimize="False" ShowMaximize="False"/>
    <StackPanel Grid.Row="1" Margin="24,8,24,20">
      <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="{DynamicResource DeckTextSoft}" FontSize="14" Focusable="False"/>
      </ScrollViewer>
      <ui:TextBox x:Name="Input" Style="{StaticResource EditorInput}" Margin="0,12,0,0"
                  AutomationProperties.Name="Valeur" TextChanged="OnTextChanged"/>
      <TextBlock x:Name="Error" Foreground="{DynamicResource DeckDanger}" FontSize="12" Margin="2,6,0,0"
                 AutomationProperties.LiveSetting="Assertive" Visibility="Collapsed"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <ui:Button x:Name="CancelButton" Content="Annuler" IsCancel="True" MinHeight="48" Padding="22,0" Margin="0,0,8,0"
                   FocusVisualStyle="{StaticResource DeckFocusVisual}"/>
        <ui:Button x:Name="OkButton" Content="OK" Appearance="Primary" IsDefault="True" MinHeight="48" Padding="22,0"
                   FocusVisualStyle="{StaticResource DeckFocusVisual}" Click="OnOk"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
