<ui:FluentWindow x:Class="TouchDeck.Controls.QuickCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:TouchDeck.ViewModels"
        Title="Nouveau bouton" Width="540" SizeToContent="Height" MinHeight="300" MaxHeight="780"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <!--
    Création rapide : tape un nom d'action, Entrée crée. Échap ferme sans rien écrire. Fenêtre légère, ouverte depuis le menu d'une case
    du deck : le deck, lui, ne prend jamais le focus.
  -->
  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <DataTemplate DataType="{x:Type vm:CatalogItemViewModel}">
      <Grid MinHeight="52" Margin="2,2" AutomationProperties.Name="{Binding AutomationName}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="40" Height="40" CornerRadius="10" Background="{Binding Color}" VerticalAlignment="Center">
          <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource DeckText}"/>
          <TextBlock Text="{Binding Description}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource DeckDim}"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </ui:FluentWindow.Resources>

  <Grid Background="{DynamicResource DeckWindow}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ui:TitleBar x:Name="Bar" Grid.Row="0" Title="Nouveau bouton" ShowMinimize="False" ShowMaximize="False"/>
    <StackPanel Grid.Row="1" Margin="24,4,24,20">
      <TextBlock Text="Que doit faire ce bouton ?" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource DeckText}" Margin="2,0,0,8"/>
      <ui:TextBox x:Name="Search" Style="{StaticResource EditorInput}" PlaceholderText="Tape un nom : chrome, volume, micro…"
                  Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                  Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                  AutomationProperties.Name="Rechercher une action" PreviewKeyDown="OnSearchKeyDown"/>

      <ListBox x:Name="List" ItemsSource="{Binding Suggestions}" SelectedItem="{Binding Selected, Mode=TwoWay}" MaxHeight="244" Margin="0,8,0,0"
               Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.PanningMode="VerticalOnly" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnRowDoubleClick"
               AutomationProperties.Name="Actions proposées"/>
      <TextBlock Text="{Binding Message}" Style="{StaticResource EditorHint}" Foreground="{DynamicResource DeckDanger}"
                 AutomationProperties.LiveSetting="Assertive" Visibility="{Binding HasMessage, Converter={StaticResource BoolVis}}"/>

      <TextBlock Text="Titre du bouton" Style="{StaticResource EditorHint}" Margin="2,14,0,4"/>
      <ui:TextBox x:Name="TitleBox" Style="{StaticResource EditorInput}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                  AutomationProperties.Name="Titre du bouton"/>

      <TextBlock Text="Icône (nom Fluent, emoji ou texte court)" Style="{StaticResource EditorHint}" Margin="2,12,0,4"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource DeckSurfaceHi}" Margin="0,0,8,0" AutomationProperties.Name="Aperçu de l'icône">
          <Grid>
            <ui:SymbolIcon Symbol="{Binding IconPreview}" FontSize="26" Foreground="{DynamicResource DeckText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding IconPreviewText}" FontSize="22" Foreground="{DynamicResource DeckText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="2"/>
          </Grid>
        </Border>
        <ui:TextBox Grid.Column="1" Style="{StaticResource EditorInput}" Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="Icône du bouton"/>
      </Grid>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <ui:Button x:Name="CancelButton" Content="Annuler" IsCancel="True" MinHeight="48" MinWidth="110" Padding="22,0" Margin="0,0,8,0"
                   Command="{Binding CancelCommand}" FocusVisualStyle="{StaticResource DeckFocusVisual}"/>
        <ui:Button x:Name="CreateButton" Content="Créer" Appearance="Primary" IsDefault="True" MinHeight="48" MinWidth="110" Padding="22,0"
                   Command="{Binding CreateCommand}" FocusVisualStyle="{StaticResource DeckFocusVisual}"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
