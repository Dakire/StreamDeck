<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:vm="clr-namespace:StreamDak.ViewModels"
                    xmlns:controls="clr-namespace:StreamDak.Controls">
  <!-- Modèles des widgets et de l'invite « Ajouter un bouton » (fusionnés dans MainWindow.xaml). Les styles et convertisseurs viennent de App.xaml. -->
  <!-- ===== Widgets : tuiles d'affichage (hors édition). Un toucher bref ne fait rien ; appui long ou clic droit : menu de la case ===== -->

  <!-- Horloge : l'heure en grand et la date, mises à l'échelle de la tuile -->
  <DataTemplate DataType="{x:Type vm:ClockWidgetViewModel}">
    <Border Background="{Binding Face.Background}" BorderBrush="{Binding Face.Border}" BorderThickness="1" AutomationProperties.Name="{Binding AccessibleName}"
            Margin="{Binding DataContext.L.TilePad, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CornerRadius="{Binding DataContext.L.TileRadius, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
      <Viewbox Margin="28,20" Stretch="Uniform">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{Binding Time}" FontSize="64" FontWeight="SemiBold" Foreground="{Binding Face.LabelBrush}" HorizontalAlignment="Center"
                     FontFamily="Segoe UI Variable Display, Segoe UI" AutomationProperties.LiveSetting="Off"/>
          <TextBlock Text="{Binding Date}" FontSize="20" Foreground="{DynamicResource DeckTextSoft}" HorizontalAlignment="Center"
                     Visibility="{Binding ShowDate, Converter={StaticResource BoolVis}}"/>
        </StackPanel>
      </Viewbox>
    </Border>
  </DataTemplate>

  <!-- Processeur / Mémoire : la valeur en grand, un détail et une jauge (alerte au-delà de 85 %), mises à jour chaque seconde -->
  <DataTemplate DataType="{x:Type vm:SystemMeterWidgetViewModel}">
    <Border Background="{Binding Face.Background}" BorderBrush="{Binding Face.Border}" BorderThickness="1" AutomationProperties.Name="{Binding AccessibleName}"
            Margin="{Binding DataContext.L.TilePad, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CornerRadius="{Binding DataContext.L.TileRadius, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
      <Grid Margin="18,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Foreground="{DynamicResource DeckAccentText}" Margin="0,0,8,0" VerticalAlignment="Center"
                         FontSize="{Binding DataContext.L.BarFont, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
            <ui:SymbolIcon.Style>
              <Style TargetType="ui:SymbolIcon">
                <Setter Property="Symbol" Value="DeveloperBoard24"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsRam}" Value="True"><Setter Property="Symbol" Value="Memory16"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </ui:SymbolIcon.Style>
          </ui:SymbolIcon>
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{Binding Face.LabelBrush}" VerticalAlignment="Center"
                     FontSize="{Binding DataContext.L.BarFont, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
        </StackPanel>
        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,6"
                 Visibility="{Binding HasReading, Converter={StaticResource BoolVis}}">
          <StackPanel>
            <TextBlock Text="{Binding Headline}" FontSize="54" FontWeight="SemiBold" Foreground="{Binding Face.LabelBrush}"
                       FontFamily="Segoe UI Variable Display, Segoe UI" AutomationProperties.LiveSetting="Off"/>
            <TextBlock Text="{Binding Detail}" FontSize="16" Foreground="{DynamicResource DeckTextSoft}"
                       Visibility="{Binding HasDetail, Converter={StaticResource BoolVis}}"/>
          </StackPanel>
        </Viewbox>
        <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource DeckDim}"
                   FontSize="{Binding DataContext.L.BarFont, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                   Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}"/>
        <ProgressBar Grid.Row="2" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="10" VerticalAlignment="Bottom"
                     Visibility="{Binding HasReading, Converter={StaticResource BoolVis}}" AutomationProperties.Name="{Binding Title}">
          <ProgressBar.Style>
            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
              <Setter Property="Foreground" Value="{DynamicResource DeckAccent}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsHigh}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DeckDanger}"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </ProgressBar.Style>
        </ProgressBar>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- Widgets de données (ping, météo, disque, services…) : valeur en grand colorée selon la gravité, détail, jauge facultative -->
  <DataTemplate DataType="{x:Type vm:DataWidgetViewModel}">
    <Border Background="{Binding Face.Background}" BorderBrush="{Binding Face.Border}" BorderThickness="1" AutomationProperties.Name="{Binding AccessibleName}"
            Margin="{Binding DataContext.L.TilePad, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CornerRadius="{Binding DataContext.L.TileRadius, RelativeSource={RelativeSource AncestorType=ItemsControl}}" ClipToBounds="True">
      <Grid Margin="16,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Symbol="{Binding Symbol}" Foreground="{DynamicResource DeckAccentText}" Margin="0,0,8,0" VerticalAlignment="Center"
                         FontSize="{Binding DataContext.L.BarFont, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{Binding Face.LabelBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     FontSize="{Binding DataContext.L.BarFont, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
        </StackPanel>
        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,4"
                 Visibility="{Binding HasReading, Converter={StaticResource BoolVis}}">
          <TextBlock Text="{Binding Headline}" FontSize="48" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" AutomationProperties.LiveSetting="Off">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{Binding Face.LabelBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsGood}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DeckSuccess}"/></DataTrigger>
                  <DataTrigger Binding="{Binding IsWarning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DeckWarning}"/></DataTrigger>
                  <DataTrigger Binding="{Binding IsDanger}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DeckDanger}"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Viewbox>
        <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource DeckDim}"
                   FontSize="{Binding DataContext.L.BarFont, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                   Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}"/>
        <TextBlock Grid.Row="2" Text="{Binding Detail}" FontSize="14" Foreground="{DynamicResource DeckTextSoft}" TextTrimming="CharacterEllipsis" MaxHeight="150"
                   Visibility="{Binding HasDetail, Converter={StaticResource BoolVis}}"/>
        <ProgressBar Grid.Row="3" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay, TargetNullValue=0}" Height="10" Margin="0,8,0,0" VerticalAlignment="Bottom"
                     Visibility="{Binding HasPercent, Converter={StaticResource BoolVis}}" AutomationProperties.Name="{Binding Title}">
          <ProgressBar.Style>
            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
              <Setter Property="Foreground" Value="{DynamicResource DeckAccent}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsWarning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DeckWarning}"/></DataTrigger>
                <DataTrigger Binding="{Binding IsDanger}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DeckDanger}"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </ProgressBar.Style>
        </ProgressBar>
      </Grid>
    </Border>
  </DataTemplate>

  <!--
    Niveau audio : roue ou curseur tactile lié à un canal Sonar, à Discord ou à un périphérique Windows. Le doigt est routé vers le contrôle par la fenêtre (ADR 0013).
    En-tête : icône de la cible, nom, pastille de disponibilité, et en dessous ce que le contrôle règle réellement (jamais de volume Windows présenté comme un gain Sonar).
    Pied : couper (curseurs : la roue coupe au toucher du centre) et revenir au niveau de réinitialisation, en cibles de 48 px.
  -->
  <Style x:Key="LevelAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="48"/>
    <Setter Property="Height" Value="48"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <DataTemplate x:Key="LevelHeader" DataType="{x:Type vm:LevelWidgetViewModel}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <ui:SymbolIcon Symbol="{Binding Symbol}" Foreground="{DynamicResource DeckAccentText}" Margin="0,0,8,0" VerticalAlignment="Center"
                     FontSize="{Binding DataContext.L.BarFont, RelativeSource={RelativeSource AncestorType=Window}}"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{Binding Face.LabelBrush}" TextTrimming="CharacterEllipsis"
                   FontSize="{Binding DataContext.L.BarFont, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <TextBlock Text="{Binding Controls}" Foreground="{DynamicResource DeckTextSoft}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Controls}"
                   Visibility="{Binding HasControls, Converter={StaticResource BoolVis}}"/>
      </StackPanel>
      <Ellipse Grid.Column="2" Width="10" Height="10" Margin="8,0,2,0" VerticalAlignment="Center" ToolTip="{Binding Availability}"
               AutomationProperties.Name="{Binding Availability}">
        <Ellipse.Style>
          <Style TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource DeckDim}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsAvailable}" Value="True"><Setter Property="Fill" Value="{DynamicResource DeckSuccess}"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </Ellipse.Style>
      </Ellipse>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="LevelClassicBody" DataType="{x:Type vm:LevelWidgetViewModel}">
    <Grid Margin="12,10,12,6">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LevelHeader}"/>
    <controls:LevelControl Grid.Row="1" Margin="0,6,0,0" Shape="{Binding Shape}" Value="{Binding Level, Mode=OneWay}" IsMuted="{Binding IsMuted}"
                           ChangeCommand="{Binding ChangeCommand}" MuteCommand="{Binding ToggleMuteCommand}"
                           TrackBrush="{DynamicResource DeckTileTrack}" FillBrush="{DynamicResource DeckAccent}" MutedBrush="{DynamicResource DeckDanger}"
                           TextBrush="{Binding Face.LabelBrush}" AutomationProperties.Name="{Binding AccessibleName}"
                           Visibility="{Binding HasReading, Converter={StaticResource BoolVis}}"/>
    <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource DeckDim}"
               FontSize="{Binding DataContext.L.BarFont, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
               Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding ShowActions, Converter={StaticResource BoolVis}}">
      <Button Style="{StaticResource LevelAction}" Command="{Binding ToggleMuteCommand}" Visibility="{Binding ShowMuteButton, Converter={StaticResource BoolVis}}"
              AutomationProperties.Name="Couper ou rétablir" ToolTip="Couper ou rétablir">
        <ui:SymbolIcon>
          <ui:SymbolIcon.Style>
            <Style TargetType="ui:SymbolIcon">
              <Setter Property="Symbol" Value="Speaker224"/>
              <Setter Property="Foreground" Value="{DynamicResource DeckTextSoft}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMuted}" Value="True"><Setter Property="Symbol" Value="SpeakerMute24"/><Setter Property="Foreground" Value="{DynamicResource DeckDanger}"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:SymbolIcon.Style>
        </ui:SymbolIcon>
      </Button>
      <Button Style="{StaticResource LevelAction}" Command="{Binding ResetCommand}" AutomationProperties.Name="{Binding ResetText}" ToolTip="{Binding ResetText}">
        <ui:SymbolIcon Symbol="ArrowReset24" Foreground="{DynamicResource DeckTextSoft}"/>
      </Button>
    </StackPanel>
  </Grid>
  </DataTemplate>
  <DataTemplate x:Key="LevelVerticalBody" DataType="{x:Type vm:LevelWidgetViewModel}">
    <controls:VerticalSlider/>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:LevelWidgetViewModel}">
    <Border Background="{Binding Face.Background}" BorderBrush="{Binding Face.Border}" BorderThickness="1" AutomationProperties.Name="{Binding AccessibleName}"
            Margin="{Binding DataContext.L.TilePad, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CornerRadius="{Binding DataContext.L.TileRadius, RelativeSource={RelativeSource AncestorType=ItemsControl}}" ClipToBounds="True">
      <ContentControl Content="{Binding}" Focusable="False" IsTabStop="False">
        <ContentControl.Style>
          <Style TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource LevelClassicBody}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsVertical}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource LevelVerticalBody}"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </ContentControl.Style>
      </ContentControl>
    </Border>
  </DataTemplate>

  <!-- Mélangeur audio : une ligne par canal (icône, nom, ce qui est réglé, curseur horizontal avec la valeur exacte, couper, réinitialiser) -->
  <DataTemplate DataType="{x:Type vm:MixerWidgetViewModel}">
    <Border Background="{Binding Face.Background}" BorderBrush="{Binding Face.Border}" BorderThickness="1" AutomationProperties.Name="{Binding AccessibleName}"
            Margin="{Binding DataContext.L.TilePad, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CornerRadius="{Binding DataContext.L.TileRadius, RelativeSource={RelativeSource AncestorType=ItemsControl}}" ClipToBounds="True">
      <ItemsControl ItemsSource="{Binding Channels}" Margin="14,10" Focusable="False" VerticalAlignment="Center">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:LevelWidgetViewModel}">
            <Grid MinHeight="56" Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="120"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LevelHeader}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <controls:LevelControl Grid.Column="1" Shape="HorizontalSlider" Value="{Binding Level, Mode=OneWay}" IsMuted="{Binding IsMuted}"
                                     ChangeCommand="{Binding ChangeCommand}" MuteCommand="{Binding ToggleMuteCommand}"
                                     TrackBrush="{DynamicResource DeckTileTrack}" FillBrush="{DynamicResource DeckAccent}" MutedBrush="{DynamicResource DeckDanger}"
                                     TextBrush="{Binding Face.LabelBrush}" AutomationProperties.Name="{Binding Title}"
                                     Visibility="{Binding HasReading, Converter={StaticResource BoolVis}}"/>
              <TextBlock Grid.Column="1" Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource DeckDim}"
                         ToolTip="{Binding Status}" Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}"/>
              <Button Grid.Column="2" Style="{StaticResource LevelAction}" Command="{Binding ToggleMuteCommand}" Margin="6,0,0,0"
                      AutomationProperties.Name="Couper ou rétablir" ToolTip="Couper ou rétablir">
                <ui:SymbolIcon>
                  <ui:SymbolIcon.Style>
                    <Style TargetType="ui:SymbolIcon">
                      <Setter Property="Symbol" Value="Speaker224"/>
                      <Setter Property="Foreground" Value="{DynamicResource DeckTextSoft}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMuted}" Value="True"><Setter Property="Symbol" Value="SpeakerMute24"/><Setter Property="Foreground" Value="{DynamicResource DeckDanger}"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
              </Button>
              <Button Grid.Column="3" Style="{StaticResource LevelAction}" Command="{Binding ResetCommand}"
                      AutomationProperties.Name="{Binding ResetText}" ToolTip="{Binding ResetText}">
                <ui:SymbolIcon Symbol="ArrowReset24" Foreground="{DynamicResource DeckTextSoft}"/>
              </Button>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
  </DataTemplate>

  <!-- Agenda : prochains événements, ou ce qu'il manque pour en afficher -->
  <DataTemplate DataType="{x:Type vm:AgendaWidgetViewModel}">
    <Border Background="{Binding Face.Background}" BorderBrush="{Binding Face.Border}" BorderThickness="1" AutomationProperties.Name="{Binding AccessibleName}"
            Margin="{Binding DataContext.L.TilePad, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CornerRadius="{Binding DataContext.L.TileRadius, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
      <Grid Margin="18,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <ui:SymbolIcon Symbol="CalendarLtr24" Foreground="{DynamicResource DeckAccentText}" Margin="0,0,8,0"
                         FontSize="{Binding DataContext.L.BarFont, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
          <TextBlock Text="Agenda" FontWeight="SemiBold" Foreground="{Binding Face.LabelBrush}" VerticalAlignment="Center"
                     FontSize="{Binding DataContext.L.BarFont, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
        </StackPanel>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Entries}" Focusable="False" ClipToBounds="True"
                      Visibility="{Binding HasEntries, Converter={StaticResource BoolVis}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:AgendaEntry}">
              <StackPanel Margin="0,0,0,6">
                <TextBlock Text="{Binding Day}" FontWeight="SemiBold" Foreground="{DynamicResource DeckDim}" Margin="0,4,0,2"
                           FontSize="{Binding DataContext.L.SubFont, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Day}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="64"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding When}" Foreground="{DynamicResource DeckAccentText}" FontWeight="SemiBold" Margin="0,0,10,0"
                             FontSize="{Binding DataContext.L.BarFont, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource DeckText}"
                             FontSize="{Binding DataContext.L.BarFont, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                </Grid>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource DeckDim}"
                   FontSize="{Binding DataContext.L.BarFont, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                   Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}"/>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- Page web : bande de commandes et cadre isolé (WebView2) -->
  <DataTemplate DataType="{x:Type vm:WebWidgetViewModel}">
    <controls:WebWidgetView/>
  </DataTemplate>

  <!-- Page ou dossier vide : la première case invite à ajouter un bouton (toucher = menu de création) -->
  <DataTemplate DataType="{x:Type vm:WelcomeTileViewModel}">
    <Button Style="{StaticResource AddTileButton}" Command="{Binding Click}" AutomationProperties.Name="Ajouter un bouton"
            AutomationProperties.HelpText="Ouvre le menu de création. Un appui long sur n'importe quelle case vide fait de même."
            Margin="{Binding DataContext.L.TilePad, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            Tag="{Binding DataContext.L.TileRadius, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ui:SymbolIcon Symbol="Add24" Foreground="{DynamicResource DeckAccentText}" HorizontalAlignment="Center"
                       FontSize="{Binding DataContext.L.AddGlyphSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
        <TextBlock Text="Ajouter un bouton" Foreground="{DynamicResource DeckText}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"
                   TextWrapping="Wrap" TextAlignment="Center" FontSize="{Binding DataContext.L.BarFont, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
      </StackPanel>
    </Button>
  </DataTemplate>
</ResourceDictionary>
