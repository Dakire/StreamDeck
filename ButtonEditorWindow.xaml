<ui:FluentWindow x:Class="TouchDeck.ButtonEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:b="clr-namespace:TouchDeck.Behaviors"
        xmlns:vm="clr-namespace:TouchDeck.ViewModels"
        Title="{Binding Title}" Width="820" Height="900"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI">

  <Window.Resources>
    <!-- Une action : en-tête, type, puis les champs propres au type -->
    <DataTemplate DataType="{x:Type vm:ActionEditorViewModel}">
      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
              CornerRadius="16" Padding="16,10,16,14" Margin="0,0,0,12">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <ui:Button Icon="{ui:SymbolIcon ArrowUp24}" Command="{Binding MoveUpCommand}" Width="40" Height="40" Margin="4,0,0,0"
                         Visibility="{Binding CanMoveUp, Converter={StaticResource BoolVis}}"/>
              <ui:Button Icon="{ui:SymbolIcon ArrowDown24}" Command="{Binding MoveDownCommand}" Width="40" Height="40" Margin="4,0,0,0"
                         Visibility="{Binding CanMoveDown, Converter={StaticResource BoolVis}}"/>
              <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding RemoveCommand}" Width="40" Height="40" Margin="4,0,0,0"
                         Visibility="{Binding CanRemove, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
          </Grid>

          <ItemsControl ItemsSource="{Binding TypeChoices}" Style="{StaticResource ChipWrap}" Margin="0,6,0,0"/>

          <TextBlock Text="{Binding ValueCaption}" Style="{StaticResource EditorCaption}"
                     Visibility="{Binding ShowValue, Converter={StaticResource BoolVis}}"/>
          <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}"
                      b:HotkeyCapture.Enabled="True"
                      Visibility="{Binding ShowValue, Converter={StaticResource BoolVis}}"/>
          <ui:Button Content="Parcourir…" Icon="{ui:SymbolIcon Folder24}" Command="{Binding BrowseValueCommand}"
                     Style="{StaticResource EditorChip}" Margin="0,8,0,0" HorizontalAlignment="Left"
                     Visibility="{Binding ShowBrowseValue, Converter={StaticResource BoolVis}}"/>
          <TextBlock Text="{Binding ValueHint}" Style="{StaticResource EditorHint}"
                     Visibility="{Binding ShowValueHint, Converter={StaticResource BoolVis}}"/>

          <!-- Touches média -->
          <StackPanel Visibility="{Binding ShowMedia, Converter={StaticResource BoolVis}}">
            <TextBlock Text="COMMANDE MÉDIA" Style="{StaticResource EditorCaption}"/>
            <ItemsControl ItemsSource="{Binding MediaChoices}" Style="{StaticResource ChipWrap}"/>
          </StackPanel>

          <!-- Pages -->
          <StackPanel Visibility="{Binding ShowPage, Converter={StaticResource BoolVis}}">
            <TextBlock Text="ALLER À LA PAGE" Style="{StaticResource EditorCaption}"/>
            <ItemsControl ItemsSource="{Binding PageChoices}" Style="{StaticResource ChipWrap}"/>
          </StackPanel>

          <!-- Fenêtres ouvertes -->
          <ItemsControl ItemsSource="{Binding ProcessChoices}" Style="{StaticResource ChipWrap}" Margin="0,6,0,0"
                        Visibility="{Binding ShowProcesses, Converter={StaticResource BoolVis}}"/>

          <!-- Arguments / programme de repli -->
          <StackPanel Visibility="{Binding ShowArgs, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding ArgsCaption}" Style="{StaticResource EditorCaption}"/>
            <ui:TextBox Text="{Binding Args, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}"/>
            <ui:Button Content="Parcourir…" Icon="{ui:SymbolIcon Folder24}" Command="{Binding BrowseArgsCommand}"
                       Style="{StaticResource EditorChip}" Margin="0,8,0,0" HorizontalAlignment="Left"
                       Visibility="{Binding ShowBrowseArgs, Converter={StaticResource BoolVis}}"/>
            <TextBlock Text="{Binding ArgsHint}" Style="{StaticResource EditorHint}"
                       Visibility="{Binding ShowArgsHint, Converter={StaticResource BoolVis}}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TemplateGroupViewModel}">
      <StackPanel>
        <TextBlock Text="{Binding Name}" Style="{StaticResource EditorCaption}"/>
        <ItemsControl ItemsSource="{Binding Items}" Style="{StaticResource ChipWrap}"/>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMinimize="False" ShowMaximize="False"/>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
      <StackPanel Margin="24,8,24,16">

        <!-- Modèles (uniquement à la création) -->
        <StackPanel Visibility="{Binding IsNew, Converter={StaticResource BoolVis}}">
          <ui:Button Command="{Binding ToggleTemplatesCommand}" Style="{StaticResource EditorChip}" MinHeight="46"
                     Content="Partir d'un modèle  (Chrome, Google, 3CX, Keeper)" Icon="{ui:SymbolIcon Copy24}"/>
          <ItemsControl ItemsSource="{Binding TemplateGroups}" Focusable="False"
                        Visibility="{Binding TemplatesOpen, Converter={StaticResource BoolVis}}"/>
        </StackPanel>
        <TextBlock Text="{Binding Note}" Foreground="#FFD38A" FontSize="13" TextWrapping="Wrap" Margin="2,4,0,4"
                   Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}"/>

        <!-- Aperçu + libellé / icône -->
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="150" Height="150" CornerRadius="22" BorderBrush="#26FFFFFF" BorderThickness="1"
                  Background="{Binding PreviewBrush}">
            <StackPanel VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="{Binding PreviewSymbol}" FontSize="52" Foreground="White" HorizontalAlignment="Center"
                             Visibility="{Binding HasPreviewSymbol, Converter={StaticResource BoolVis}}"/>
              <TextBlock Text="{Binding PreviewIcon}" FontSize="52" FontFamily="Segoe UI Emoji" Foreground="White"
                         HorizontalAlignment="Center" Visibility="{Binding HasPreviewText, Converter={StaticResource BoolVis}}"/>
              <TextBlock Text="{Binding PreviewLabel}" FontSize="15" FontWeight="SemiBold" Foreground="White"
                         TextAlignment="Center" TextWrapping="Wrap" Margin="6,4,6,0"/>
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <TextBlock Text="LIBELLÉ" Style="{StaticResource EditorCaption}" Margin="2,0,0,6"/>
            <ui:TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}"/>
            <TextBlock Text="ICÔNE (NOM FLUENT, EMOJI OU TEXTE COURT)" Style="{StaticResource EditorCaption}"/>
            <ui:TextBox Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}"/>
          </StackPanel>
        </Grid>

        <TextBlock Text="ICÔNES" Style="{StaticResource EditorCaption}"/>
        <ItemsControl ItemsSource="{Binding IconChoices}" Style="{StaticResource ChipWrap}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:Button Width="48" Height="48" Padding="0" Margin="0,0,6,6" CornerRadius="12" Focusable="False"
                         Command="{Binding Command}" ToolTip="{Binding Name}">
                <ui:Button.Style>
                  <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Appearance" Value="Primary"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
                <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="22"/>
              </ui:Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Style="{StaticResource EditorHint}"
                   Text="Tu peux aussi saisir un emoji (Win + ; ouvre le sélecteur de Windows) ou un nom d'icône Fluent."/>

        <!-- Couleur -->
        <TextBlock Text="COULEUR" Style="{StaticResource EditorCaption}"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150"/>
          </Grid.ColumnDefinitions>
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
            <ItemsControl ItemsSource="{Binding Swatches}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
          <ui:TextBox Grid.Column="1" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}"/>
        </Grid>

        <!-- Actions -->
        <TextBlock Text="ACTIONS (EXÉCUTÉES DANS L'ORDRE)" Style="{StaticResource EditorCaption}"/>
        <ItemsControl ItemsSource="{Binding Actions}" Focusable="False"/>
        <ui:Button Content="Ajouter une action" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddActionCommand}"
                   Style="{StaticResource EditorChip}"/>
      </StackPanel>
    </ScrollViewer>

    <!-- Pied de fenêtre -->
    <Grid Grid.Row="2" Margin="24,10,24,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Visibility="{Binding IsExisting, Converter={StaticResource BoolVis}}">
        <ui:Button Content="{Binding DeleteText}" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger"
                   Command="{Binding DeleteCommand}" Height="48" Margin="0,0,8,0" Padding="16,0"/>
        <ui:Button Content="Avant" Icon="{ui:SymbolIcon ChevronLeft24}" Command="{Binding MoveBeforeCommand}"
                   Height="48" Margin="0,0,8,0" Padding="16,0"/>
        <ui:Button Content="Après" Icon="{ui:SymbolIcon ChevronRight24}"
                   Command="{Binding MoveAfterCommand}" Height="48" Padding="16,0"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <ui:Button Content="Annuler" Command="{Binding CancelCommand}" Height="48" Margin="8,0,0,0" Padding="20,0"/>
        <ui:Button Content="{Binding SaveText}" Appearance="Primary" Command="{Binding SaveCommand}"
                   Height="48" Margin="8,0,0,0" Padding="20,0"/>
      </StackPanel>
    </Grid>
  </Grid>
</ui:FluentWindow>
