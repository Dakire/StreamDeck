<ui:FluentWindow x:Class="StreamDak.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:StreamDak.ViewModels"
        xmlns:b="clr-namespace:StreamDak.Behaviors"
        xmlns:controls="clr-namespace:StreamDak.Controls"
        Title="Paramètres — StreamDak" Width="820" Height="860" MinWidth="560" MinHeight="520"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">

  <ui:FluentWindow.Resources>
    <Style x:Key="SettingsCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource DeckPanel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DeckLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,10,16,12"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource DeckFocusVisual}"/>
    </Style>
    <Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource DeckFocusVisual}"/>
    </Style>
    <Style TargetType="ui:NumberBox" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource DeckFocusVisual}"/>
    </Style>
  </ui:FluentWindow.Resources>

  <Grid Background="{DynamicResource DeckWindow}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="Paramètres — StreamDak" ShowMinimize="True" ShowMaximize="False">
      <ui:TitleBar.Icon><ui:ImageIcon Source="{StaticResource StreamDakLogo}"/></ui:TitleBar.Icon>
    </ui:TitleBar>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
      <StackPanel Margin="28,8,28,28" MaxWidth="760">

        <!-- Apparence -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Apparence" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Thème" Style="{StaticResource EditorCaption}" Margin="0,8,0,6"/>
            <ItemsControl ItemsSource="{Binding ThemeChoices}" Style="{StaticResource ChipWrap}"/>
            <ui:ToggleSwitch Content="Réduire les animations" IsChecked="{Binding ReduceMotion, Mode=TwoWay}" Margin="0,6,0,0"
                             AutomationProperties.Name="Réduire les animations"/>
            <TextBlock Style="{StaticResource EditorHint}" Text="Windows demande déjà de supprimer les animations : StreamDak en tient compte."
                       Visibility="{Binding SystemReducesMotion, Converter={StaticResource BoolVis}}"/>
            <ui:ToggleSwitch Content="Garder les emojis tels quels (au lieu des icônes Fluent)" IsChecked="{Binding EmojiIcons, Mode=TwoWay}"/>
            <ui:ToggleSwitch Content="Couleur de fond personnalisée (sinon effet Mica)" IsChecked="{Binding CustomBackground, Mode=TwoWay}"/>
            <StackPanel Visibility="{Binding CustomBackground, Converter={StaticResource BoolVis}}">
              <ui:TextBox Text="{Binding Background, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}" PlaceholderText="#RRGGBB"
                          AutomationProperties.Name="Couleur de fond du deck en hexadécimal"/>
              <TextBlock Text="{Binding BackgroundError}" Foreground="{DynamicResource DeckDanger}" FontSize="12" Margin="2,6,0,0"
                         AutomationProperties.LiveSetting="Assertive"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Deck -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Affichage du deck" Style="{StaticResource SectionTitle}"/>
            <ui:ToggleSwitch Content="Plein écran sur l'écran du deck" IsChecked="{Binding Fullscreen, Mode=TwoWay}"/>
            <ui:ToggleSwitch Content="Toujours au premier plan" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"/>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Colonnes (0 = auto)" Style="{StaticResource EditorCaption}" Margin="0,0,0,6"/>
                <ui:NumberBox Value="{Binding Columns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="20" MaxDecimalPlaces="0" SpinButtonPlacementMode="Inline"
                              AutomationProperties.Name="Colonnes par défaut, zéro pour automatique"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Lignes (0 = auto)" Style="{StaticResource EditorCaption}" Margin="0,0,0,6"/>
                <ui:NumberBox Value="{Binding Rows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="20" MaxDecimalPlaces="0" SpinButtonPlacementMode="Inline"
                              AutomationProperties.Name="Lignes par défaut, zéro pour automatique"/>
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Espacement" Style="{StaticResource EditorCaption}" Margin="0,0,0,6"/>
                <ui:NumberBox Value="{Binding Spacing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="80" MaxDecimalPlaces="0" SpinButtonPlacementMode="Inline"
                              AutomationProperties.Name="Espacement entre les boutons"/>
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource EditorHint}"
                       Text="Ces valeurs s'appliquent aux profils dont le format est « Automatique ». Le format propre à un profil se choisit dans l'éditeur."/>
          </StackPanel>
        </Border>

        <!-- Périphériques -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Périphériques" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Écran du deck" Style="{StaticResource EditorCaption}" Margin="0,8,0,6"/>
            <ComboBox ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen, Mode=TwoWay}" AutomationProperties.Name="Écran du deck"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite">
              <ui:SymbolIcon FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center">
                <ui:SymbolIcon.Style>
                  <Style TargetType="ui:SymbolIcon">
                    <Setter Property="Symbol" Value="PlugDisconnected24"/>
                    <Setter Property="Foreground" Value="{DynamicResource DeckDanger}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding DeviceConnected}" Value="True">
                        <Setter Property="Symbol" Value="PlugConnected24"/>
                        <Setter Property="Foreground" Value="{DynamicResource DeckSuccess}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:SymbolIcon.Style>
              </ui:SymbolIcon>
              <TextBlock Text="{Binding DeviceText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock Text="Écrans détectés" Style="{StaticResource EditorCaption}"/>
            <ItemsControl ItemsSource="{Binding Displays}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding}" Margin="0,2" Foreground="{DynamicResource DeckTextSoft}"/></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource EditorHint}"
                       Text="Si l'écran du deck est débranché, le deck revient sur l'écran principal ; il repart sur l'écran tactile dès qu'il est rebranché."/>
          </StackPanel>
        </Border>

        <!-- Démarrage -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Démarrage" Style="{StaticResource SectionTitle}"/>
            <ui:ToggleSwitch Content="Lancer StreamDak à l'ouverture de session Windows" IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>
          </StackPanel>
        </Border>

        <!-- Mises à jour -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel DataContext="{Binding Updates}">
            <TextBlock Text="Mises à jour" Style="{StaticResource SectionTitle}"/>
            <TextBlock Style="{StaticResource EditorHint}" Margin="0,0,0,8" TextWrapping="Wrap">
              <Run Text="Version installée : "/><Run Text="{Binding CurrentVersionText, Mode=OneWay}" FontWeight="SemiBold"/>
              <Run Text="{Binding RepositoryText, Mode=OneWay, StringFormat=' · releases de {0} sur GitHub'}"/>
            </TextBlock>
            <ui:Button Content="Rechercher des mises à jour" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding CheckNowCommand}" MinHeight="36" HorizontalAlignment="Left"
                       AutomationProperties.Name="Rechercher des mises à jour"/>
            <TextBlock Text="{Binding StatusText}" Margin="0,10,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DeckDanger}" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers><DataTrigger Binding="{Binding ErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <!-- Version disponible : notes, puis Installer maintenant / Plus tard / Ignorer cette version -->
            <Border BorderBrush="{DynamicResource DeckLine}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0" Visibility="{Binding ShowDetails, Converter={StaticResource BoolVis}}">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap">
                  <Run Text="Version "/><Run Text="{Binding NewVersionText, Mode=OneWay}"/><Run Text=" disponible"/>
                </TextBlock>
                <TextBlock Style="{StaticResource EditorHint}" TextWrapping="Wrap">
                  <Run Text="Tu as la "/><Run Text="{Binding CurrentVersionText, Mode=OneWay}"/><Run Text="."/>
                </TextBlock>
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8" Focusable="False">
                  <controls:MarkdownView Blocks="{Binding Notes}"/>
                </ScrollViewer>
                <StackPanel Visibility="{Binding IsInstalling, Converter={StaticResource BoolVis}}">
                  <ProgressBar Minimum="0" Maximum="1" Height="8" Value="{Binding Progress, Mode=OneWay, TargetNullValue=0}">
                    <ProgressBar.Style>
                      <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                        <Style.Triggers><DataTrigger Binding="{Binding Progress}" Value="{x:Null}"><Setter Property="IsIndeterminate" Value="True"/></DataTrigger></Style.Triggers>
                      </Style>
                    </ProgressBar.Style>
                  </ProgressBar>
                  <TextBlock Text="{Binding ProgressText}" Margin="0,6,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                  <ui:Button Content="Annuler" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelDownloadCommand}" MinHeight="36" AutomationProperties.Name="Annuler le téléchargement"/>
                </StackPanel>
                <WrapPanel>
                  <WrapPanel.Style>
                    <Style TargetType="WrapPanel">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers><DataTrigger Binding="{Binding IsInstalling}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                    </Style>
                  </WrapPanel.Style>
                  <ui:Button Content="Installer maintenant" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding InstallNowCommand}" MinHeight="36" Margin="0,0,8,8"
                             Visibility="{Binding CanInstall, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Installer maintenant"/>
                  <ui:Button Content="Voir la release" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenReleasePageCommand}" MinHeight="36" Margin="0,0,8,8" AutomationProperties.Name="Voir la release sur GitHub">
                    <ui:Button.Style>
                      <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding CanInstall}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                      </Style>
                    </ui:Button.Style>
                  </ui:Button>
                  <ui:Button Content="Plus tard" Command="{Binding PostponeUpdateCommand}" MinHeight="36" Margin="0,0,8,8" AutomationProperties.Name="Plus tard"/>
                  <ui:Button Content="Ignorer cette version" Command="{Binding IgnoreUpdateCommand}" MinHeight="36" Margin="0,0,8,8" AutomationProperties.Name="Ignorer cette version"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <ui:ToggleSwitch Content="Vérifier au démarrage (une fois par jour au plus, en arrière-plan)" IsChecked="{Binding AutoCheck, Mode=TwoWay}" Margin="0,8,0,0" MinHeight="36"/>
            <ui:ToggleSwitch Content="Canal bêta : proposer aussi les pré-versions" IsChecked="{Binding Beta, Mode=TwoWay}" MinHeight="36"/>
            <TextBlock Style="{StaticResource EditorHint}" TextWrapping="Wrap"
                       Text="Rien ne s'installe sans ton accord. Le téléchargement n'a lieu que depuis les releases GitHub du dépôt configuré (update.json), en HTTPS, et l'installateur n'est lancé que si sa somme SHA-256 correspond à celle publiée. Tes profils ne sont jamais touchés."/>
          </StackPanel>
        </Border>

        <!-- Intégrations -->
        <Border Style="{StaticResource SettingsCard}" Visibility="{Binding Integrations.Count, Converter={StaticResource CountVis}}">
          <StackPanel>
            <TextBlock Text="Intégrations" Style="{StaticResource SectionTitle}"/>
            <TextBlock Style="{StaticResource EditorHint}" Margin="0,0,0,8"
                       Text="Pilote d'autres logiciels depuis les touches. StreamDak se reconnecte tout seul si le logiciel est fermé puis relancé. Les mots de passe et jetons sont chiffrés pour ton compte Windows : ils ne sont jamais écrits dans config.json."/>
            <ItemsControl ItemsSource="{Binding Integrations}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:IntegrationCardViewModel}">
                  <Border BorderBrush="{DynamicResource DeckLine}" BorderThickness="0,1,0,0" Padding="0,8,0,6" Margin="0,3,0,0" AllowDrop="True"
                          DragEnter="OnIntegrationDragEnter" DragLeave="OnIntegrationDragLeave" DragOver="OnIntegrationDragOver" Drop="OnIntegrationDrop">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Style.Triggers>
                          <Trigger Property="b:DropState.IsOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DeckAccentSoft}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DeckAccent}"/>
                            <Setter Property="BorderThickness" Value="0,3,0,0"/>
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <!-- Poignée : glisser pour réordonner (Alt + flèches au clavier) -->
                        <Border x:Name="IntegrationGrip" Width="28" Height="36" Background="Transparent" Cursor="SizeAll" Focusable="True" KeyboardNavigation.IsTabStop="True" Margin="0,0,4,0"
                                ToolTip="Glisser pour changer l'ordre (Alt + flèches au clavier)" AutomationProperties.Name="{Binding Name, StringFormat='Déplacer {0} : glisser ou Alt et flèches'}"
                                PreviewMouseLeftButtonDown="OnIntegrationGripDown" PreviewMouseMove="OnIntegrationGripMove" PreviewKeyDown="OnIntegrationGripKey"
                                FocusVisualStyle="{StaticResource DeckFocusVisual}">
                          <ui:SymbolIcon Symbol="ReOrderDotsVertical24" FontSize="18" Foreground="{DynamicResource DeckDim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ui:SymbolIcon Grid.Column="1" Symbol="{Binding Symbol}" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                          <StackPanel Orientation="Horizontal" AutomationProperties.LiveSetting="Polite">
                            <ui:SymbolIcon Symbol="{Binding StatusSymbol}" FontSize="14" Margin="0,2,6,0" Foreground="{DynamicResource DeckDim}"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource DeckDim}" FontSize="12" TextWrapping="Wrap"/>
                          </StackPanel>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="3" IsChecked="{Binding IsEnabled, Mode=TwoWay}" OnContent="Activé" OffContent="Désactivé"
                                         AutomationProperties.Name="{Binding Name, StringFormat='Activer {0}'}"/>
                      </Grid>
                      <TextBlock Text="{Binding Help}" Style="{StaticResource EditorHint}" Margin="0,4,0,0"/>
                      <ItemsControl ItemsSource="{Binding Fields}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:IntegrationFieldViewModel}">
                            <StackPanel Margin="0,4,0,0">
                              <TextBlock Text="{Binding Label}" Style="{StaticResource EditorCaption}" Margin="2,6,0,4"/>
                              <ui:TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" Style="{StaticResource EditorInput}"
                                          Visibility="{Binding IsPlain, Converter={StaticResource BoolVis}}" AutomationProperties.Name="{Binding Label}"/>
                              <ui:PasswordBox Password="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" MinHeight="36"
                                              Visibility="{Binding IsSecret, Converter={StaticResource BoolVis}}" AutomationProperties.Name="{Binding Label}"/>
                              <TextBlock Text="{Binding Hint}" Style="{StaticResource EditorHint}" Visibility="{Binding HasHint, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{Binding PairHelp}" Style="{StaticResource EditorHint}" Visibility="{Binding CanPair, Converter={StaticResource BoolVis}}"/>
                      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button Content="{Binding PairLabel}" Icon="{ui:SymbolIcon Link24}" Command="{Binding PairCommand}" Style="{StaticResource EditorChip}"
                                   Visibility="{Binding CanPair, Converter={StaticResource BoolVis}}"/>
                        <ui:Button Content="Tester la connexion" Icon="{ui:SymbolIcon PlugConnected24}" Command="{Binding TestCommand}" Style="{StaticResource EditorChip}"/>
                        <TextBlock Text="{Binding TestResult}" VerticalAlignment="Center" Margin="4,0,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Sauvegardes -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Sauvegardes" Style="{StaticResource SectionTitle}"/>
            <TextBlock Style="{StaticResource EditorHint}" Margin="0,0,0,8"
                       Text="Une sauvegarde automatique est faite à chaque lancement quand la configuration a changé (15 conservées), et avant tout import ou restauration."/>
            <WrapPanel>
              <ui:Button Content="Exporter la configuration…" Icon="{ui:SymbolIcon ArrowExportUp24}" Command="{Binding ExportConfigCommand}" Style="{StaticResource EditorChip}"/>
              <ui:Button Content="Importer une configuration…" Icon="{ui:SymbolIcon ArrowImport24}" Command="{Binding ImportConfigCommand}" Style="{StaticResource EditorChip}"/>
              <ui:Button Content="Sauvegarder maintenant" Icon="{ui:SymbolIcon Save24}" Command="{Binding BackupNowCommand}" Style="{StaticResource EditorChip}"/>
            </WrapPanel>
            <TextBlock Text="Sauvegardes automatiques" Style="{StaticResource EditorCaption}"/>
            <TextBlock Text="Aucune sauvegarde pour le moment.">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource EditorHint}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Backups.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Backups}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:BackupItemViewModel}">
                  <Grid MinHeight="36">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                    <ui:Button Grid.Column="1" Content="Restaurer" MinHeight="36" Padding="16,0" Command="{Binding RestoreCommand}"
                               FocusVisualStyle="{StaticResource DeckFocusVisual}" AutomationProperties.Name="{Binding Display, StringFormat='Restaurer la sauvegarde du {0}'}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,10,0,0">
              <ui:Button Content="Ouvrir le dossier de configuration" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenFolderCommand}" Style="{StaticResource EditorChip}"/>
              <ui:Button Content="Ouvrir config.json" Icon="{ui:SymbolIcon Document24}" Command="{Binding OpenConfigFileCommand}" Style="{StaticResource EditorChip}"/>
              <ui:Button Content="Recharger depuis le disque" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding ReloadCommand}" Style="{StaticResource EditorChip}"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- Raccourcis -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Raccourcis clavier de l'éditeur" Style="{StaticResource SectionTitle}"/>
            <ItemsControl x:Name="ShortcutList" Focusable="False" AutomationProperties.Name="Liste des raccourcis clavier">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid MinHeight="36">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Keys}" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center" Foreground="{DynamicResource DeckAccentText}"/>
                    <TextBlock Grid.Column="1" Text="{Binding What}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource EditorHint}" Text="Ces raccourcis ne s'appliquent jamais pendant la saisie dans un champ de texte. Dans le deck tactile, rien n'est intercepté : les raccourcis envoyés vont à l'application active."/>
          </StackPanel>
        </Border>

        <!-- À propos -->
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="À propos" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource DeckTextSoft}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ConfigDirectory, StringFormat='Configuration : {0}'}" Style="{StaticResource EditorHint}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</ui:FluentWindow>
