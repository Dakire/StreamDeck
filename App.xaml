<Application x:Class="TouchDeck.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:TouchDeck.ViewModels"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ui:ThemesDictionary Theme="Dark"/>
      <ui:ControlsDictionary/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Bouton de grille : carte arrondie, léger relief, retour visuel au toucher -->
    <Style x:Key="DeckButton" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Tag"><Setter.Value><CornerRadius>22</CornerRadius></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
              <Border x:Name="Card" CornerRadius="{TemplateBinding Tag}" Background="{TemplateBinding Background}"
                      BorderBrush="#26FFFFFF" BorderThickness="1">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.35" Color="Black"/>
                </Border.Effect>
              </Border>
              <!-- reflet doux en haut de la carte -->
              <Border CornerRadius="{TemplateBinding Tag}" IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#22FFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Border x:Name="Press" CornerRadius="{TemplateBinding Tag}" Background="White" Opacity="0" IsHitTestVisible="False"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.07"/>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.07"/>
                      <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0:0:0.07"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="#44FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Boutons de barre (onglets, menus, actions discrètes) : à plat, sans ombre -->
    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Tag"><Setter.Value><CornerRadius>16</CornerRadius></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border CornerRadius="{TemplateBinding Tag}" Background="{TemplateBinding Background}"/>
              <Border x:Name="Press" CornerRadius="{TemplateBinding Tag}" Background="White" Opacity="0" IsHitTestVisible="False"/>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Press" Property="Opacity" Value="0.16"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Emplacement vide du mode édition : cadre en pointillés -->
    <Style x:Key="AddTileButton" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Tag"><Setter.Value><CornerRadius>22</CornerRadius></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Rectangle x:Name="Frame"
                         RadiusX="{Binding Tag.TopLeft, RelativeSource={RelativeSource TemplatedParent}}"
                         RadiusY="{Binding Tag.TopLeft, RelativeSource={RelativeSource TemplatedParent}}"
                         Stroke="{DynamicResource DeckPlaceholder}" StrokeThickness="2" StrokeDashArray="4 4" Margin="2"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource DeckAccent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Fenêtres d'édition ===== -->
    <BooleanToVisibilityConverter x:Key="BoolVis"/>

  <!-- Pastille tactile : la pastille sélectionnée prend la couleur d'accent -->
  <Style x:Key="EditorChip" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
    <Setter Property="MinHeight" Value="42"/>
    <Setter Property="CornerRadius" Value="21"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="Margin" Value="0,0,8,8"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Focusable" Value="False"/>
  </Style>

  <!-- Pastilles liées à un ChoiceViewModel -->
  <DataTemplate DataType="{x:Type vm:ChoiceViewModel}">
    <ui:Button Command="{Binding Command}" Content="{Binding Text}">
      <ui:Button.Style>
        <Style TargetType="ui:Button" BasedOn="{StaticResource EditorChip}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter Property="Appearance" Value="Primary"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ui:Button.Style>
    </ui:Button>
  </DataTemplate>

  <!-- Pastille de couleur -->
  <DataTemplate DataType="{x:Type vm:SwatchViewModel}">
    <ui:Button Width="44" Height="44" Padding="0" CornerRadius="22" Margin="0,0,8,0" Focusable="False"
               Command="{Binding Command}" Background="{Binding Brush}" MouseOverBackground="{Binding Brush}"
               PressedBackground="{Binding Brush}" BorderThickness="0"
               HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
      <ui:SymbolIcon Symbol="Checkmark24" Foreground="White" FontSize="22"
                     Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}"/>
    </ui:Button>
  </DataTemplate>

  <!-- Liste de pastilles qui passent à la ligne -->
  <Style x:Key="ChipWrap" TargetType="ItemsControl">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="ItemsPanel">
      <Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="EditorCaption" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="2,12,0,6"/>
  </Style>

  <Style x:Key="EditorHint" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="2,6,0,0"/>
  </Style>

  <Style x:Key="EditorInput" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Padding" Value="12,10"/>
  </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
