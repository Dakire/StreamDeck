<Application x:Class="TouchDeck.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:TouchDeck.ViewModels"
             xmlns:controls="clr-namespace:TouchDeck.Controls">
  <Application.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ui:ThemesDictionary Theme="Dark"/>
      <ui:ControlsDictionary/>
      <ResourceDictionary Source="Themes/Tokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <controls:CountToVisibilityConverter x:Key="CountVis"/>

    <!-- ===== Deck tactile ===== -->

    <!-- Touche du deck (MD3) : corps teinté (Background) et liseré de sa couleur (BorderBrush), sans ombre : l'élévation se lit par le ton.
         Couches d'état : survol 8 %, appui 12 %. L'appui répond immédiatement (50 ms) : l'action part au relâchement, l'animation ne la retarde jamais. -->
    <Style x:Key="DeckButton" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DeckTileLine}"/>
      <Setter Property="Tag"><Setter.Value><CornerRadius>22</CornerRadius></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
              <Border x:Name="Card" CornerRadius="{TemplateBinding Tag}" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
              <Border x:Name="Hover" CornerRadius="{TemplateBinding Tag}" Background="White" Opacity="0" IsHitTestVisible="False"/>
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
              <Border x:Name="Press" CornerRadius="{TemplateBinding Tag}" Background="White" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.05"/>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.05"/>
                      <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.05"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="0.08"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Même touche sans animation (réduction des animations) : l'appui est indiqué par un voile et un contour épais -->
    <Style x:Key="DeckButtonStatic" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DeckTileLine}"/>
      <Setter Property="Tag"><Setter.Value><CornerRadius>22</CornerRadius></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Card" CornerRadius="{TemplateBinding Tag}" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
              <Border x:Name="Hover" CornerRadius="{TemplateBinding Tag}" Background="White" Opacity="0" IsHitTestVisible="False"/>
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
              <Border x:Name="Press" CornerRadius="{TemplateBinding Tag}" Background="White" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="PressRing" CornerRadius="{TemplateBinding Tag}" BorderBrush="{DynamicResource DeckFocus}" BorderThickness="3"
                      Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Press" Property="Opacity" Value="0.2"/>
                <Setter TargetName="PressRing" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="0.05"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Style effectif des boutons du deck : Motion le remplace par la variante statique si les animations sont coupées -->
    <Style x:Key="DeckTileStyle" TargetType="Button" BasedOn="{StaticResource DeckButton}"/>

    <!-- Boutons de barre (onglets, menus, actions discrètes) : à plat, sans ombre -->
    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Tag"><Setter.Value><CornerRadius>16</CornerRadius></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border CornerRadius="{TemplateBinding Tag}" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
              <Border x:Name="Press" CornerRadius="{TemplateBinding Tag}" Background="White" Opacity="0" IsHitTestVisible="False"/>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Press" Property="Opacity" Value="0.08"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Press" Property="Opacity" Value="0.18"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Emplacement vide du mode édition : cadre en pointillés -->
    <Style x:Key="AddTileButton" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Tag"><Setter.Value><CornerRadius>22</CornerRadius></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Rectangle x:Name="Frame"
                         RadiusX="{Binding Tag.TopLeft, RelativeSource={RelativeSource TemplatedParent}}"
                         RadiusY="{Binding Tag.TopLeft, RelativeSource={RelativeSource TemplatedParent}}"
                         Stroke="{DynamicResource DeckPlaceholder}" StrokeThickness="2" StrokeDashArray="4 4" Margin="2"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource DeckAccentText}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Éditeur : styles partagés ===== -->

    <!-- Anneau de focus clavier visible (WCAG 2.4.7 / 2.4.11) -->
    <Style x:Key="DeckFocusVisual">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="-3" RadiusX="12" RadiusY="12" Stroke="{DynamicResource DeckFocus}" StrokeThickness="2" StrokeDashArray="3 2"
                       SnapsToDevicePixels="True" IsHitTestVisible="False"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Pastille tactile : la pastille sélectionnée prend la couleur d'accent -->
    <Style x:Key="EditorChip" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="MinHeight" Value="48"/>
      <Setter Property="CornerRadius" Value="24"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource DeckFocusVisual}"/>
    </Style>

    <!-- Pastilles liées à un ChoiceViewModel -->
    <DataTemplate DataType="{x:Type vm:ChoiceViewModel}">
      <ui:Button Command="{Binding Command}" Content="{Binding Text}" AutomationProperties.Name="{Binding Text}">
        <ui:Button.Style>
          <Style TargetType="ui:Button" BasedOn="{StaticResource EditorChip}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Appearance" Value="Primary"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ui:Button.Style>
      </ui:Button>
    </DataTemplate>

    <!-- Pastille de couleur : la case cochée est signalée par un repère en plus de la couleur -->
    <DataTemplate DataType="{x:Type vm:SwatchViewModel}">
      <ui:Button Width="48" Height="48" Padding="0" CornerRadius="24" Margin="0,0,8,8"
                 Command="{Binding Command}" Background="{Binding Brush}" MouseOverBackground="{Binding Brush}"
                 PressedBackground="{Binding Brush}" BorderThickness="2" BorderBrush="{DynamicResource DeckSwatchRing}"
                 FocusVisualStyle="{StaticResource DeckFocusVisual}"
                 AutomationProperties.Name="{Binding Color, StringFormat='Couleur {0}'}"
                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
        <ui:SymbolIcon Symbol="Checkmark24" Foreground="White" FontSize="22"
                       Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}">
          <ui:SymbolIcon.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black" Opacity="1"/></ui:SymbolIcon.Effect>
        </ui:SymbolIcon>
      </ui:Button>
    </DataTemplate>

    <!-- Liste de pastilles qui passent à la ligne -->
    <Style x:Key="ChipWrap" TargetType="ItemsControl">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="ItemsPanel">
        <Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="EditorCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DeckDim}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="2,14,0,6"/>
    </Style>

    <Style x:Key="EditorHint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DeckDim}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="2,6,0,0"/>
    </Style>

    <Style x:Key="EditorInput" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
      <Setter Property="MinHeight" Value="48"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource DeckFocusVisual}"/>
    </Style>

    <!-- Bouton icône seul (barre d'outils, panneaux) -->
    <Style x:Key="IconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource DeckFocusVisual}"/>
    </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
