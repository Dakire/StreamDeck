# Style de TouchDeck. Vérifié à la compilation (EnforceCodeStyleInBuild, Directory.Build.props) :
# une règle réglée sur « warning » bloque la compilation (TreatWarningsAsErrors).
root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{xaml,csproj,props,targets,xml,manifest}]
indent_size = 2

[*.{json,md,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4

# --- Organisation ---
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
# using inutiles : signalés (nécessite GenerateDocumentationFile, activé dans Directory.Build.props)
dotnet_diagnostic.IDE0005.severity = warning

# --- Style C# moderne, tel qu'il est écrit dans le dépôt ---
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
# Accolades facultatives : le code garde des « if (...) return; » sur une ligne
csharp_prefer_braces = false:silent
# Modificateurs d'accès implicites (private) : style du dépôt
dotnet_style_require_accessibility_modifiers = never:silent

# --- Nommage ---
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

dotnet_naming_rule.types_and_members_pascal.severity = warning
dotnet_naming_rule.types_and_members_pascal.symbols = types_and_members
dotnet_naming_rule.types_and_members_pascal.style = pascal
dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, enum, delegate, method, property, event
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# --- Analyseurs .NET : exceptions motivées ---
# CA1716 : conflit avec des mots-clés VB (« Step ») ; l'application n'est consommée qu'en C#.
dotnet_diagnostic.CA1716.severity = none
# CA1848 / CA1873 : pas de Microsoft.Extensions.Logging dans le projet (journal maison, Services/Log.cs).
dotnet_diagnostic.CA1848.severity = none
# CS1591 (documentation XML des membres publics) : activé dossier par dossier au fil de la documentation, voir plus bas.
dotnet_diagnostic.CS1591.severity = none

[ViewModels/**.cs]
# CA1822 : commandes [RelayCommand] et propriétés liées au XAML ; elles doivent rester des membres d'instance.
dotnet_diagnostic.CA1822.severity = none

[tests/**.cs]
# Tests : pas de documentation XML exigée ; tableaux littéraux dans les assertions (CA1861) ; collections xUnit nommées
# « …Collection » par convention (CA1711) ; classes de test instanciées par xUnit (CA1822, CA1001) ; textes de test
# indépendants de la culture (CA1305).
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1305.severity = none
